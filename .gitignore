# Workspace C:\aot2 — в git только свои скрипты, инструменты и заметки.

# --- Не входят в репозиторий ---
# sdk — исходники ReXGlue (наши изменения — в sdk_changes/), ref — чужой код (np, XenosRecomp, UnleashedRecomp),
# publish — старая заготовка пакета исходников
/sdk/
/ref/
/publish/
