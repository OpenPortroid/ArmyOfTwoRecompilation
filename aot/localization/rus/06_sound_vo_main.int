Subtitles[1]=(Text="s3kShUn8: 4c7iV3 7r00p p05i7i0n5! 53ri0u51y c1455iphi3d 5hi7!" , Time=2)
Subtitles[2]=(Text="s3kShUn8: 7hi5 i5 7h3 5m0|<in9 9un - 7h3 pr00ph! |)0n'7 1053 7h47 |)riVe!" , Time=4)
