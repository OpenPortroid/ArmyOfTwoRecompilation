Subtitles[0]=(Text="РИОС: Это безумие!" , Time=0)
[58_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Мы застряли в этом ангаре, братан." , Time=0)
[59_ACC_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Если увижу Клайда, я его нахуй убью." , Time=0)
[59_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
