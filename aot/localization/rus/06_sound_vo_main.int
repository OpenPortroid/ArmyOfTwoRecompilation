[5_ACC_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="КЛАЙД: Научитесь стрелять, ебаньки, я не собираюсь тащить ваши трупы к Далтону." , Time=0)
[50_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="РИОС: Ничего, Элис. Потом поговорим. Нам пора прыгать. Прием." , Time=0)
[52_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ты что, черт возьми, творишь?" , Time=0)
[53_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: А что? Надо рассказать ей про Клайда!" , Time=0)
[54_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Не раньше, чем мы поймем, что происходит." , Time=0)
Subtitles[1]=(Text="РИОС: Я подключил ту флешку к своему GPS," , Time=2.2)
Subtitles[2]=(Text="РИОС: и s3kShUn8 посмотрит ее удаленно." , Time=4.9)
Subtitles[3]=(Text="РИОС: Ничего не говори, пока он не скажет, в чем дело." , Time=7.5)
Subtitles[4]=(Text="РИОС: Ничего не говори, пока он не скажет, в чем дело." , Time=7.5)
[55_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Риос, Сейлем, если застряли, попробуйте прорезать сварочным аппаратом дыру в решетке на полу. Ясно?" , Time=0)
[56_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="06_sound_vo_main"
Subtitles[0]=(Text="МЮРРЕЙ: Парни, вы меня не слышали? Прорежьте сварочным аппаратом дыру в решетке под вами!" , Time=0)
[56A_ACC_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
