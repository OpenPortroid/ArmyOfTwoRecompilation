[68_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Да что с вами сегодня такое? Откройте уже эту чертову дверь! Используйте самолет! Прием." , Time=0)
[69_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="06_sound_vo_main"
Subtitles[0]=(Text="МЮРРЕЙ: Вам нужно взорвать эту дверь. Быстрее! Прием." , Time=0)
