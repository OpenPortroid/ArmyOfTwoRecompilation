Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: И что, блять, смешного?" , Time=0)
[57_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="06_sound_vo_main"
Subtitles[0]=(Text="МЮРРЕЙ: Риос, Сейлем. Быстрее. Прорежьте сварочным аппаратом дыру в решетке, на которой стоите!" , Time=0)
[57A_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Вот еще один ноутбук. Может, тут больше информации о том, что Клайд делал с теми террористами." , Time=0)
[57B_ACC_SALEM SoundNodeWave]
