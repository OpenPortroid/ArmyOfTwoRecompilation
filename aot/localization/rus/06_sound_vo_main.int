[43_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="06_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Может, глянем, что на том ноутбуке." , Time=0)
[44_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Слышь, братан, может, глянем, что на этом ноутбуке?" , Time=0)
[45_ACC_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Знаешь, я ни разу раньше не был на авианосце - а тут круто." , Time=0)
[45_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="06_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Может, проверим этот ноутбук." , Time=0)
[46_ACC_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Здорово, Эллиот." , Time=0)
[46_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Риос, Сейлем - капитан авианосца еще жив! Вам нужно вывести его с корабля." , Time=0)
[47_ACC_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Прямо как Звезда Смерти, понимаешь?" , Time=0)
Subtitles[1]=(Text="СЕЙЛЕМ: Все жду, что увижу принцессу Лею, C-3PO и всю эту херню." , Time=2)
[47_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Элис, ты что, не видела, что сейчас было?" , Time=0)
[48_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: А что было?" , Time=0)
[49_ACC_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="06_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Знаешь, ты немного похож на Чубакку - если бы волосы чуть отрастил." , Time=0)
[49_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
