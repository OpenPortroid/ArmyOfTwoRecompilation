bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="КЛАЙД: Без проблем, ебанько." , Time=0)
[70_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="06_sound_vo_main"
Subtitles[0]=(Text="МЮРРЕЙ: Чтобы пробить эту дверь, нужна серьезная взрывчатка." , Time=0)
