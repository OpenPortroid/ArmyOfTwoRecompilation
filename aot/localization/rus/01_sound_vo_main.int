[120_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="КЛАЙД: Клайд - Ричарду Далтону. Задание выполнено." , Time=0)
Subtitles[1]=(Text="КЛАЙД: Переведите вторую половину гонорара на мой счет." , Time=2.48)
