[53A_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Стой. Я слышу там наверху врагов." , Time=0)
Subtitles[1]=(Text="РИОС: Я тебя подсажу, а ты их снимешь." , Time=2.1)
[53B_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Ладно. Тихо и аккуратно. Стоп, вот здесь." , Time=0)
[53C_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
