[127_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="КЛАЙД: Хватит ныть, обойдите здание с другой стороны. Надо зачистить рынок, чтобы Далтон мог посадить вертолет для эвакуации." , Time=0)
[128_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Надо поговорить с Далтоном. Этот тип - конченый мудак." , Time=0)
