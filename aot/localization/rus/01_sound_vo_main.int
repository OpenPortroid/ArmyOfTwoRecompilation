[96_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Четверо врагов прорвали периметр. Еще один - и игра окончена." , Time=0)
[97_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Ну и фрукт этот тип." , Time=0)
[97_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Блять! Вы пропустили пятерых. Значит, начинаем сначала. В этот раз не облажайтесь! Держитесь рядом и защищайте круг! Прием." , Time=0)
[98_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Они всегда такие." , Time=0)
[98_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Риос - защищай напарника!" , Time=0)
[99_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Где, черт возьми, Клайд? Я думал, ему платят, чтобы он убрал этого типа." , Time=0)
[99_TRAINING_PEDRO SoundNodeWave]
