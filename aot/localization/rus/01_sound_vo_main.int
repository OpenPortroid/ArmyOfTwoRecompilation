bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Знаю." , Time=0)
Subtitles[1]=(Text="РИОС: Я пытался ему сказать, но он и слушать не стал." , Time=1.2)
[13_SOM_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Класс. Берите тот багги. Если повезет, прикроем вас, пока не выйдете из зоны. Удачи там - Ура!" , Time=0)
[13_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="ПЕДРО: Педро - Риосу и Сейлему." , Time=0)
Subtitles[1]=(Text="ПЕДРО: Ну что, дамочки, готовы?" , Time=2.41)
Subtitles[2]=(Text="ПЕДРО: В этой тренировке мы используем резиновые пули," , Time=4.13)
Subtitles[3]=(Text="ПЕДРО: так что никто не умрет. Но если в вас попадут," , Time=6.7)
Subtitles[4]=(Text="ПЕДРО: будет чертовски больно. Ясно?" , Time=10.29)
[130_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Вот что в армии паршиво. Мы не выбираем ни задания, ни с кем работать. Просто выполняем приказы." , Time=0)
[131_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Ты только сейчас это понял?" , Time=0)
[132_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="КЛАЙД: Используйте парный снайпинг, чтобы взорвать тот бензобак." , Time=0)
Subtitles[1]=(Text="КЛАЙД: Взрыв убьет охрану." , Time=3.7)
[135_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: А, да, нас этому учили." , Time=0)
[136_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="КЛАЙД: Ну так делайте, нахуй!" , Time=0)
