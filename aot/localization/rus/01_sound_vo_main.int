bAlwaysLocalise=True
bManualWordWrap=False
Comment="01_sound_vo_main"
Subtitles[0]=(Text="КЛАЙД: Тогда убирайте их! И не за что за подсказку." , Time=0)
[139_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="КЛАЙД: Вы что творите? Стрелять надо одновременно!" , Time=0)
