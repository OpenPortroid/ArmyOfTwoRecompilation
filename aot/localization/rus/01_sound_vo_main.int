[109B_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Ха-ха! Вот это было круто! Так, Сейлем - твой напарник ранен, так что сделай ему реанимацию, чтобы спасти его." , Time=0)
