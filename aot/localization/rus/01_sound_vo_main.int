Subtitles[0]=(Text="РИОС: Молодец" , Time=0)
[53D_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Теперь подтягивайся." , Time=0)
[53E_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Отлично, теперь помоги мне подняться!" , Time=0)
[53F_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Йо, там наверху враги." , Time=0)
Subtitles[1]=(Text="СЕЙЛЕМ: Я тебя подниму, а ты их снимешь." , Time=1.3)
[53G_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Эй, отлично. Они мои." , Time=0)
[53H_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Красава, бро" , Time=0)
[53I_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Э-э, ты не то чтобы легкий, бро. Подтягивайся!" , Time=0)
[53J_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Отлично, теперь помоги мне подняться!" , Time=0)
[54_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Где мы должны встретить этого типа?" , Time=0)
[54_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Так, Риос. Сейлем отвлек их внимание. Вперед!" , Time=0)
[55_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: В старом отеле «Континенталь»." , Time=0)
[55_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Риос, вперед! Давай!" , Time=0)
[56_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: И где это, черт возьми?" , Time=0)
[56_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: Вперед, Риос! Сейлем отвлек их внимание. Прием." , Time=0)
[57_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Там, впереди, нам сюда." , Time=0)
[57_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Отличная работа, вот так это делается! Прием." , Time=0)
[58_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="СЕЙЛЕМ: Хорошо, что ты знаешь, куда идти." , Time=0)
Subtitles[1]=(Text="СЕЙЛЕМ: По мне, вся эта херня одинаковая." , Time=1)
[58_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Хорошая работа.  Теперь до вас доходит!" , Time=0)
[58A_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="РИОС: Осторожно!" , Time=0)
[59_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Блять, чувак, нас прижали." , Time=0)
[59_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: Отлично, рейнджеры! У-а!" , Time=0)
[59A_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Осторожно!" , Time=0)
[60_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Знаю. Не могу даже выстрелить." , Time=0)
[60_TRAINING_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: У-у-а!" , Time=0)
[61_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Плохо дело, чувак. Очень плохо." , Time=0)
[61_TRAINING_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: У-а!" , Time=0)
[61A_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: На поле боя вам может понадобиться разное оружие. Так что я решил заставить вас менять оружие и на этой тренировке. Достаньте дополнительное оружие." , Time=0)
[62_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Да кем этот тип себя возомнил?" , Time=0)
[62_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Это армия, братишки. Если кто-то из нас не справляется в одиночку, мы работаем вместе. Прием." , Time=0)
[63_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Бро, это было офигенно. Тебе о таких навыках только мечтать." , Time=0)
[63_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Что с вами не так? Поднимайте ворота вместе. Прием." , Time=0)
[64_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Я капрал Тайсон Риос, а это рядовой первого класса Эллиот Сейлем, четвертое подразделение, рейнджеры армии США. Вы Филлип Клайд?" , Time=0)
[64_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Давайте. Если ворота слишком тяжелые, поднимите их вдвоем." , Time=0)
[65_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="КЛАЙД: А ты, блять, как думаешь?" , Time=0)
[65_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Мы прошли примерно половину, так что считайте это промежуточным экзаменом. Используйте навыки, которые мы только что отработали, чтобы убрать этого парня.  У него бронежилет и лучшее оружие, так что будет непросто. Прием." , Time=0)
[65A_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: Вспомните, чему мы научились." , Time=0)
Subtitles[1]=(Text="ПЕДРО: Убить этого парня можно, только зайдя ему за спину." , Time=1.7)
[65B_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Давайте, работайте как команда. Если один из вас идет вперед, пусть скажет другому стоять на месте!" , Time=0)
[66_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Бро. Мы должны помочь тебе убрать полковника Мо'Алима." , Time=0)
[66_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Давайте, рейнджеры. Используйте совместный бой, о котором я вам говорил. Пусть один из вас отвлекает его на себя, а другой продвигается. Прием." , Time=0)
[67_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="КЛАЙД: Во-первых, я тебе не бро, бро." , Time=0)
Subtitles[1]=(Text="Во-вторых, не тебе говорить мне ждать. Это я говорю вам, что делать." , Time=3.05)
Subtitles[2]=(Text="И в-последних, если думаешь, что мне нужна ваша помощь в этом -" , Time=7.06)
Subtitles[3]=(Text="или в чем-то еще, - то ты идиот." , Time=9.86)
Subtitles[4]=(Text="Раз уж мы с этим разобрались, почему бы вам не заткнуться нахуй" , Time=13.27)
Subtitles[5]=(Text="и не посмотреть, как работает настоящий профессионал." , Time=16.16)
Subtitles[6]=(Text="Может, чему-нибудь научитесь." , Time=18.21)
[67_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: По очереди отвлекайте его внимание и заходите для убийства. Прием." , Time=0)
[68_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="РИОС: Ладно, профессор." , Time=0)
Subtitles[1]=(Text="РИОС: Может, для начала научишь нас, где прячется Мо'Алим?" , Time=1.69)
[68_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Помните, чему я вас учил. Один отвлекает его, пока другой продвигается. Попробуйте подкрасться к нему." , Time=0)
[69_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="КЛАЙД: Он прямо здесь, в отеле «Континенталь»." , Time=0)
Subtitles[1]=(Text="КЛАЙД: А ты думал, зачем я назначил встречу тут?" , Time=3.25)
[69_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Так, Риос. Открой заградительный огонь. Прием." , Time=0)
[7_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: У-а!" , Time=0)
[70_SOM_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ДАЛТОН: Риос, Сейлем, вы уже встретились с Клайдом? Прием." , Time=0)
[70_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Риос, прикрой Сейлема огнем. Давай." , Time=0)
[71_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Так точно, сэр. Канал защищен, сэр?" , Time=0)
[71_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Вспомни, чему мы учились, Риос. Тебе нужно открыть заградительный огонь для Эллиота." , Time=0)
[72_SOM_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ДАЛТОН: Да, защищен. В чем проблема? Прием." , Time=0)
[72_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Сейлем! Открой заградительный огонь для Риоса." , Time=0)
[73_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Видите ли, сэр, просто он вроде как... мудак, сэр. Прием." , Time=0)
[73_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Давай, Сейлем. Вспомни, что мы только что отрабатывали. Прикрой Риоса огнем." , Time=0)
[74_SOM_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ДАЛТОН: Ну, тогда не приглашайте его на ужин, когда вернетесь домой. А до тех пор выполняйте его приказы и завершите миссию. Если не убьете Мо'Алима, наши люди, застрявшие по всему городу, считай что покойники. Ясно?" , Time=0)
[74_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Сейлем! Прикрой огнем!" , Time=0)
[75_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Так точно, сэр." , Time=0)
[75_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Отличная работа, рейнджеры!" , Time=0)
[76_SOM_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ДАЛТОН: Хорошо. Конец связи." , Time=0)
[76_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="ПЕДРО: Вот так! Вот так! Так держать!" , Time=0)
[77_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Их слишком много. Надо найти укрытие." , Time=0)
[77_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Теперь вы набиваете руку! Так держать!" , Time=0)
[78_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="КЛАЙД: Так, научу-ка я вас одному фокусу." , Time=0)
Subtitles[1]=(Text="КЛАЙД: Кто-нибудь из вас, оторвите дверь у той машины." , Time=2.66)
[78_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Да! Вот как мы это делаем. Теперь идите на следующую тренировочную площадку, и побыстрее. Пора вам двоим в настоящий бой! Прием." , Time=0)
[79_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Что?" , Time=0)
[79_TRAINING_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Как думаешь, как нам туда забраться?" , Time=0)
[8_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: У-а!" , Time=0)
[80_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="КЛАЙД: Вы меня слышали." , Time=0)
[80_TRAINING_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Без понятия." , Time=0)
[81_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="КЛАЙД: Ты меня, блять, разозлить пытаешься? Я сказал, отстрелите дверь у той машины." , Time=0)
[81_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Ну же, это не ракетостроение. Пусть один подсадит другого. Потом тот, кто наверху, затащит второго. Прием." , Time=0)
[82_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="КЛАЙД: Ладно. Даю вам еще один шанс. Кто-нибудь, отстрелите дверь с этой чертовой машины." , Time=0)
[82_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Ну же, используйте подсадку. Пусть один подсадит другого. Потом тот, кто наверху, затащит второго. Прием." , Time=0)
[83_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="КЛАЙД: Очень хорошо. Теперь поднимите ее и используйте как штурмовой щит. Можете оба присесть за ней. Передний держит щит, задний стреляет." , Time=0)
[83_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Если хотите стать рейнджерами, учитесь работать вместе. Пусть один подсадит другого. Потом тот, кто наверху, затащит второго. Прием." , Time=0)
[84_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="КЛАЙД: В чем дело? Глухонемые? Один берет дверь, другой встает сзади и стреляет." , Time=0)
[84_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: Хорошая командная работа, рейнджеры." , Time=0)
[84A_TRAINING_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Так, мы закончили. Куда дальше?" , Time=0)
[84B_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="ПЕДРО: Хорошо, что спросил. Одна из важнейших вещей" , Time=0)
Subtitles[1]=(Text="в снаряжении армейского рейнджера в поле - GPS. Почему бы" , Time=4.2)
Subtitles[2]=(Text="вам не взглянуть на свои и не разобраться самим?" , Time=7.52)
[84C_TRAINING_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Почему он вечно такой умник?" , Time=0)
[84D_TRAINING_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Ага. Педро тот еще козел." , Time=0)
[84E_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Эй, и еще. Привыкайте меняться оружием в поле. Не хочу, чтобы вам снесли голову, пока вы тянетесь за пушкой напарника. Потренируйтесь сейчас. Просто обменяйтесь оружием." , Time=0)
[84F_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: А ну стоять. Видите ловушку впереди?" , Time=0)
[84G_TRAINING_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Какую ловушку?" , Time=0)
[84H_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="ПЕДРО: Не видите, да?" , Time=0)
Subtitles[1]=(Text="ПЕДРО: Вот поэтому надо постоянно проверять GPS." , Time=1.65)
[84I_TRAINING_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: GPS? Я думал, он только направление показывает." , Time=0)
[84J_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Наш GPS много чего умеет. Он показывает цели для снайпинга, задачи миссии и куда идти. Теперь проверьте GPS и уничтожьте ловушку. Любой объект, отмеченный на GPS, можно снять парным снайпингом." , Time=0)
[84K_TRAINING_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Парным снайпингом?" , Time=0)
[84L_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Ага. Это когда вы оба стреляете одновременно." , Time=0)
[84M_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Ладно. Молодцы - но спорим, вы не готовы к тому, что я приготовил дальше." , Time=0)
[84N_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Ха-ха! Риос, похоже, твоего напарника задело взрывом. Быстро оттащи его в безопасное место, где сможешь оказать первую помощь." , Time=0)
[84O_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Ха-ха! Сейлем, похоже, твоему напарнику худо. Быстро оттащи его в безопасное место, где сможешь оказать первую помощь." , Time=0)
[84P_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Эй, Риос - знаю, ты ранен, но если не будешь защищаться, тебе конец. Продолжай стрелять, пока тебя тащат." , Time=0)
[84Q_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Эй, Сейлем - знаю, ты ранен, братан, но если не будешь защищаться, тебе конец. Продолжай стрелять, пока тебя тащат." , Time=0)
[84R_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="ПЕДРО: Так, Риос, теперь окажи Сейлему первую помощь." , Time=0)
[84S_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="ПЕДРО: Так, Сейлем, теперь окажи Риосу первую помощь." , Time=0)
[84T_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Давай, Риос - ты его теряешь! Блять. Теперь придется делать реанимацию, чтобы вернуть его к жизни!" , Time=0)
[84U_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Давай, Сейлем - ты его теряешь! Блять. Теперь придется делать реанимацию, чтобы вернуть его к жизни!" , Time=0)
[84V_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Молодец, Сейлем - ты спас напарнику жизнь. Так, Риос - то, что тебя вырубило, называется мина с датчиком приближения. Рядом есть еще одна. Лучше расстреляй ее, если не хочешь снова подорваться." , Time=0)
[84W_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Молодец, Риос - ты спас напарнику жизнь. Так, Сейлем - то, что тебя вырубило, называется мина с датчиком приближения. Рядом есть еще одна. Лучше расстреляй ее, если не хочешь снова подорваться." , Time=0)
[85_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Вот это круто. Классный трюк, приятель." , Time=0)
[85_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Итак, раз вы освоили главную наступательную тактику, теперь потренируем оборону. Видите круг на земле?" , Time=0)
[86_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="КЛАЙД: И я тебе не приятель, братан, так что давай без этих ласковых прозвищ, лады?" , Time=0)
[86_TRAINING_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Ага, и что с ним?" , Time=0)
[87_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Эй, Клайд - откуда у тебя вся новейшая броня и оружие?" , Time=0)
[87_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Ну, рядовой первого класса Сейлем, раз уж ты спросил - вам нужно удерживать зону одну минуту. И при этом защищать друг друга. УКРЫТИЙ НЕТ, так что думайте об обороне. Ясно?" , Time=0)
[88_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="КЛАЙД: Я зарабатываю дохуя денег, и если мне что-то нужно, я это покупаю." , Time=0)
[88_TRAINING_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Ага. Вроде да." , Time=0)
[89_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Так хорошо платят - частному военному подрядчику?" , Time=0)
[89_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Хорошо. Если в круг прорвутся больше пяти врагов, начинаем сначала - и так снова и снова, пока не сделаете как надо. Но у меня нет целого дня, так что постарайтесь не облажаться, ладно? Прием." , Time=0)
[9_SOM_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Риос, Сейлем - слышал, вы едете в самую жопу." , Time=0)
[90_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="КЛАЙД: Подрядчик? Зови меня наемником. Я буду работать на кого угодно за хорошую цену." , Time=0)
[90_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Держитесь вместе - когда вы порознь, напарника толком не защитить. Прием." , Time=0)
[91_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Вот как, значит? Все продается тому, кто больше заплатит?" , Time=0)
[91_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Держитесь вместе, рейнджеры! Защищайте круг и друг друга! Прием." , Time=0)
[92_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="КЛАЙД: Знаешь, как говорят. Деньги решают все." , Time=0)
[92_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Держите круг! Не расходитесь!" , Time=0)
[93_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Где Клайд?" , Time=0)
[93_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Один враг прорвал оборону - чтоб больше такого не было. Прием." , Time=0)
[94_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Мне-то откуда знать, черт возьми?" , Time=0)
[94_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Второй враг прошел через оборону. Соберитесь, братва!" , Time=0)
[95_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Этот тип меня пугает. Не люблю не знать, где он." , Time=0)
[95_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Уже трое врагов прошли мимо вас. Защищайте круг! Прием." , Time=0)
[96_SOM_MO_ALIM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="МО'АЛИМ: [Смеется] Ну, посмотрите, кто тут - Джонни-американец." , Time=0)
Subtitles[1]=(Text="МО'АЛИМ: Вы думаете, что весь мир ваш -" , Time=6)
Subtitles[2]=(Text="МО'АЛИМ: что можете идти куда хотите и брать что хотите." , Time=8.2)
Subtitles[3]=(Text="МО'АЛИМ: Но это не ваша страна. Это наша страна." , Time=12.37)
Subtitles[4]=(Text="МО'АЛИМ: А вот так мы здороваемся в нашей стране!" , Time=15.78)
