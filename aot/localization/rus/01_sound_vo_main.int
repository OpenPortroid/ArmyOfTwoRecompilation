[144_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Может, не хочет тратить патроны." , Time=0)
[145_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: По-моему, этому психу просто нравится смотреть, как мы корчимся!" , Time=0)
[146_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Риос - Далтону. Как слышите?" , Time=0)
[147_SOM_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ДАЛТОН: Слышу вас, капрал. Что у вас? Прием." , Time=0)
[148_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Мы на рынке, сэр. Когда будет эвакуация? Прием." , Time=0)
[149_SOM_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ДАЛТОН: Отрицательно. Зачистите район. Там еще слишком жарко, чтобы сажать вертолет. Прием." , Time=0)
[15_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Ура!" , Time=0)
[15_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Это ты так думаешь, амиго. После вашей вчерашней выходки в столовой я сказал своим парням - без поблажек! Вам двоим надерут задницы. Прием." , Time=0)
[150_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="КЛАЙД: Вам двоим лучше подняться на тот балкон и встать за пулеметы!" , Time=0)
[151_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Что? Зачем?" , Time=0)
[152_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="КЛАЙД: Помнится, Далтон велел вам зачистить район. Думаете, справитесь отсюда со своими сраными пукалками?" , Time=0)
[153_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Как же я его ненавижу." , Time=0)
[154_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Да, но он, наверное, прав. Надо подняться." , Time=0)
[155_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="КЛАЙД: Какого черта вы двое ждете?" , Time=0)
Subtitles[1]=(Text="КЛАЙД: Поднимайтесь и помогите мне удержать позицию!" , Time=1.82)
[156_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="КЛАЙД: Если вы, придурки, хотите выбраться отсюда живыми, пиздуйте нахуй наверх и за пулеметы!" , Time=0)
[157_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="КЛАЙД: Пусть один подсадит другого на балкон. Потом тот, кто на балконе, затащит второго." , Time=0)
[158_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="КЛАЙД: Ну же! Пусть один из вас, клоунов, подсадит другого на балкон. Потом затащите того, кто внизу." , Time=0)
[159_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Ебать - они повсюду!" , Time=0)
[15A_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Перелезь через забор." , Time=0)
[15B_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Пролезь под теми воротами." , Time=0)
[16_SOM_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Эй, спасибо за магнитофон, лошара!" , Time=0)
[16_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: Так. Главное здесь - огонь на подавление. Сидите в укрытии и стреляйте вслепую. Прием." , Time=0)
[160_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: БЛЯТЬ! Блять! Их ДОХРЕНА больше!" , Time=0)
[161_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="КЛАЙД: Добро пожаловать в армию, солдат!" , Time=0)
[162_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Риос - Далтону. Район зачищен. Повторяю, район зачищен. Можете начинать эвакуацию. Прием." , Time=0)
[163_SOM_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ДАЛТОН: Вас понял, Риос. Вылетаю. Скоро буду. Конец связи." , Time=0)
[16A_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Каждый из вас должен отвлечь пулеметчика на себя. По одному. По очереди. Начинайте думать тактически. Когда один под огнем, другой ведет огонь на подавление, чтобы отвлечь врага на себя." , Time=0)
[17_SOM_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ДАЛТОН: Далтон - Гутьерресу. Когда ваше подразделение будет готово к эвакуации? Прием." , Time=0)
[17_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: В чем дело? Боитесь резиновых пуль? Один должен зайти пулеметчику с фланга. Другой - прикрывать огнем. Давайте. Быстрее! Прием." , Time=0)
[18_SOM_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: Дела плохи, сэр. Прием." , Time=0)
[19_SOM_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150340"
Subtitles[0]=(Text="ДАЛТОН: Что значит «дела плохи»?" , Time=0)
Subtitles[1]=(Text="ДАЛТОН: Переключитесь на защищенный канал UHF. Прием." , Time=2)
[20_SOM_BLACKHAWK_PILOT_1 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="СУПЕР-6-3: Мэйдэй! Мэйдэй! «Супер-6-3» падает! Повторяю! Мэйдэй! Нас подбили! Шесть-три падает -" , Time=0)
[20_TRAINING_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: А-а! Блять! Больно!" , Time=0)
[21_SOM_RANGER_1 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="ЭННИС: Шесть-три, ваши координаты? Повторяю, координаты? Прием." , Time=0)
[21_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Говорил же - больно." , Time=0)
[22_SOM_RANGER_1 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="ЭННИС: Шесть-три, шесть-три, ответьте. Ваши координаты? Ответьте! Прием." , Time=0)
[22_TRAINING_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Блять, больно!" , Time=0)
[23_SOM_RANGER_1 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="ЭННИС: Кто-нибудь на земле видит «Супер-6-3»? Прием." , Time=0)
[23_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Говорил же, братан. В настоящем бою ты бы уже был мертв." , Time=0)
[24_SOM_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Эйзенхауэр - «Супер-6-1». Как слышите?" , Time=0)
[24_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: Так, братва, хорошо. Теперь уберите пулеметчика!" , Time=0)
[25_SOM_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ДАЛТОН: Понял, Эйзенхауэр. Прием." , Time=0)
[25_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: Неплохо - вот так это делается." , Time=0)
[26_SOM_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Прошу срочную медэвакуацию, сэр. Двое раненых - один истекает кровью. Прием." , Time=0)
[27_SOM_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150340"
Subtitles[0]=(Text="ДАЛТОН: Отрицательно, Эйзенхауэр." , Time=0)
Subtitles[1]=(Text="У нас сбиты два Black Hawk, и я не могу рисковать еще одним." , Time=1.46)
Subtitles[2]=(Text="Высылаем бронемашину, чтобы вытащить вас и ваше подразделение. Прием." , Time=4.47)
[28_SOM_RANGER_2 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РЕЙНДЖЕР_2: Эннис - командованию группы 4. Сержант убит. Почти вся C-3 выбита. Остались только я и Феррис. Больше стрелять некому, сэр." , Time=0)
[29_SOM_RANGER_3 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РЕЙНДЖЕР_3: Понял. Ваша позиция? Прием." , Time=0)
[29_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: Отлично, рейнджеры! Деритесь так в бою, и, может, ваши кишки не разбросает по всему Могадишо." , Time=0)
[29A_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: Сейчас потренируемся бросать гранаты." , Time=0)
Subtitles[1]=(Text="ПЕДРО: Забросьте гранату в ту дверь." , Time=2.3)
[29B_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Молодцы. Теперь у кого-то из вас - не помню, у кого - подствольный дробовик. У кого он есть - сбейте из дробовика те металлические мишени." , Time=0)
[29C_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Теперь попробуйте забросить ее в ту дверь. Она должна взорваться по ту сторону двери. Не облажайтесь!" , Time=0)
[29D_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: Теперь идите на стрельбище, возле фасада того здания." , Time=0)
Subtitles[1]=(Text="ПЕДРО: Нам еще много чего надо пройти. Прием." , Time=3.2)
[30_SOM_RANGER_2 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РЕЙНДЖЕР_2: Мы все еще на складе, сэр. Прием." , Time=0)
[30_TRAINING_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Эй, Педро, а что там на следующей площадке?" , Time=0)
[31_SOM_RANGER_3 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РЕЙНДЖЕР_3: Что? Я послал C-1 помочь вам с эвакуацией." , Time=0)
[31_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: Скажем так, это мой маленький сюрприз. Кое-что особенное, что я приготовил специально для вас двоих. Прием." , Time=0)
[32_SOM_RANGER_2 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РЕЙНДЖЕР_2: Пока их не видели, сэр. Прием." , Time=0)
[32_TRAINING_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Что-то мне это не нравится." , Time=0)
[33_SOM_RANGER_3 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РЕЙНДЖЕР_3: Черт! Держитесь, Эннис. Конец связи." , Time=0)
[33_TRAINING_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: И что нам делать, чувак?" , Time=0)
[34_SOM_RANGER_3 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РЕЙНДЖЕР_3: C-1, где вас черти носят? Вы должны были эвакуировать C-3." , Time=0)
[34_TRAINING_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Не знаю. Осмотрись." , Time=0)
[35_SOM_RANGER_4 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РЕЙНДЖЕР_4: Нас прижали, сэр. Не можем двинуться!" , Time=0)
[35_TRAINING_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Блять, чувак. Я застрял. Как мне отсюда выбраться?" , Time=0)
[36_SOM_RANGER_3 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РЕЙНДЖЕР_3: Так прорывайтесь, черт возьми. Как слышите?" , Time=0)
[36_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Не ожидали такого, а? Выбраться оттуда можно только одним способом - освоив основы совместного боя. Риос, тебе нужно пройти по полю и нажать на переключатель в его конце, чтобы освободить Сейлема. Если попробуешь в одиночку, словишь пару пуль. Сейлем, ты должен отвлекать огонь противников на себя, чтобы Риос мог продвигаться. Только не перестарайся, иначе тебе конец. Так что вам обоим придется по очереди отвлекать огонь друг от друга. Понятно?" , Time=0)
[37_SOM_RANGER_4 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РЕЙНДЖЕР_4: Есть, сэр. Будет сделано, сэр." , Time=0)
[37_TRAINING_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Вроде да." , Time=0)
[38_SOM_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ДАЛТОН: Всем подразделениям, слушать сюда. Знаю, тут творится полный пиздец, но нам надо держать себя в руках. Мы рейнджеры. Мы лучшие из лучших и должны вести себя соответственно! Мы все отсюда выберемся - и выберемся вместе." , Time=0)
[38_TRAINING_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Есть, сэр!" , Time=0)
[39_SOM_VARIOUS_RANGERS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РЕЙНДЖЕРЫ: У-а!" , Time=0)
[39_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Хорошо. Тогда за дело. Прием." , Time=0)
[40_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Ты видишь то же, что и я?" , Time=0)
[40_TRAINING_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Блять, чувак. Я застрял." , Time=0)
[41_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Предлагаю прыгать!" , Time=0)
[41_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Что такое? Застрял? Признай, такого ты не ожидал. Выбраться оттуда можно только одним способом - освоив основы совместного боя. Сейлем, тебе нужно пройти по полю и нажать на переключатель в его конце, чтобы освободить Риоса. Если попробуешь в одиночку, словишь пару пуль. Риос, ты должен отвлекать огонь противников на себя, чтобы Сейлем мог продвигаться. Только не перестарайся, иначе тебе конец. Так что вам обоим придется по очереди отвлекать огонь друг от друга. Понятно?" , Time=0)
[42_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Погоди!" , Time=0)
[42_TRAINING_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Вроде да." , Time=0)
[43_TRAINING_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Есть, сэр!" , Time=0)
[44_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: Это было круто!" , Time=0)
[44_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Хорошо. Тогда за дело. Прием." , Time=0)
[45_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: Это ужасно." , Time=0)
[45_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Давай, Риос. Отвлеки огонь от Сейлема. Не давай ему делать всю работу. Прием." , Time=0)
[46_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="РИОС: О нет. Ты глянь." , Time=0)
[46_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Риос, ты потеряешь напарника, если не отвлечешь огонь от него. Прием." , Time=0)
[47_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Эйзенхауэр был прав. Здесь сущий ад." , Time=0)
[47_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Риос, Сейлему слишком жарко. Отвлеки от него огонь! Прием." , Time=0)
[48_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: НЕЕЕТ!!!!" , Time=0)
[48_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Сейлем, Риосу слишком жарко. Отвлеки от него огонь. Прием." , Time=0)
[49_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="СЕЙЛЕМ: ВОТ ДЕРЬМООООООО!!!" , Time=0)
[49_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="ПЕДРО: Сейлем, отвлеки-ка огонь от Риоса! Прием." , Time=0)
[50_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Ты в порядке, чувак?" , Time=0)
[50_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Давай, Сейлем, Риосу слишком жарко. Отвлеки от него огонь. Прием." , Time=0)
[51_SOM_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="hard wrap"
Subtitles[0]=(Text="СЕЙЛЕМ: Бро, вся жизнь перед глазами пронеслась - я видел свет в конце туннеля.  Там была бабуля, мама, мой старый питбуль Чарли.  Но я вернулся, чувак. Я вернулся ради тебя. Потому что знал, что без меня ты ни за что не закончишь эту миссию!" , Time=0)
[51_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="01_sound_vo_main"
Subtitles[0]=(Text="ПЕДРО: Так, Сейлем. Риос отвлек их внимание. Вперед!" , Time=0)
[52_SOM_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="РИОС: Чувак, заткнись, черт возьми." , Time=0)
[52_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
