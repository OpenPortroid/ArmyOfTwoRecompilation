[76B_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Почти готово, ребята. Откройте последние ворота!" , Time=0)
[76C_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Ребята! Откройте ворота!" , Time=0)
[76D_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Так, выше по реке есть деревня. Укройтесь там, пока я ищу способ вытащить вас из этой передряги." , Time=0)
[77_CHI_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Мы знаем, что им нужна была смерть Уайтхорса, чтобы прошел закон о приватизации армии." , Time=0)
[78_CHI_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ага. И они знали, что мы знаем про Клайда, вот и решили убить двух зайцев одним выстрелом." , Time=0)
[79_CHI_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Типичная SSC - ебаные жадные ублюдки." , Time=0)
[8_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="07_sound_vo_main"
Subtitles[0]=(Text="МЮРРЕЙ: Риос, Сейлем, впереди на берегу должен быть причал. Причаливайте и поднимайтесь по лестнице. Конец связи." , Time=0)
[80_CHI_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Слушай, Элис, по-моему, нас подставили Далтон и Стоквелл." , Time=0)
[81_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Стоквелл - возможно, но Далтон? Он вас любит, зачем ему это?" , Time=0)
[82_CHI_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Когда мы были на авианосце, мы узнали, что Клайд сливал позиции войск нашим врагам. По-нашему, это заговор, чтобы выставить армию в дурном свете и SSC получила больше заказов. Прием." , Time=0)
[83_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Что? Почему вы мне не сказали?" , Time=0)
[84_CHI_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Мы не были уверены, что тебе можно доверять." , Time=0)
[85_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 152489"
Subtitles[0]=(Text="МЮРРЕЙ: Не были уверены, можно ли мне доверять?" , Time=0)
Subtitles[1]=(Text="МЮРРЕЙ: После всего, через что мы прошли? Пошли. Вы. Нахуй." , Time=1.43)
[86_CHI_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Молодец, бро." , Time=0)
[87_CHI_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Элис, как нам отсюда выбраться? Прием." , Time=0)
[88_CHI_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Господи. Ладно. Прости, Элис. Прости." , Time=0)
[89_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Я отдала вам тринадцать лет жизни, а вы подозреваете меня в этом дерьме?" , Time=0)
[9_CHI_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Эй, Тайс, кто, по-твоему, лучший рэпер в Wu-Tang Clan?" , Time=0)
[9_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="07_sound_vo_main"
Subtitles[0]=(Text="МЮРРЕЙ: Давайте, ребята. Нет времени валять дурака. Причальте к тому пирсу. Конец связи." , Time=0)
[90_CHI_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Прости. Слушай, как нам отсюда выбраться?" , Time=0)
[91_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Не знаю. И похоже, к вам идет вся китайская армия. Пытаюсь что-нибудь придумать. Конец связи." , Time=0)
[92_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Сейчас тут начнется полный пиздец. К вам летят несколько вертолетов и идет куча пехоты. Готовьтесь." , Time=0)
[93_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Насчитываю от 20 до 50 пехотинцев плюс поддержка с воздуха. Готовьтесь!" , Time=0)
[94_CHI_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Мужик, их намного больше, чем нас..." , Time=0)
[95_CHI_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: И не говори." , Time=0)
[96_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152489"
Subtitles[0]=(Text="МЮРРЕЙ: Риос, Сейлем, слушайте. Знаю, у вас сейчас голова другим забита, но корейцы обновили контракт. По их данным, китайский агент, причастный к недавним нападениям, находится в этом районе со своим ноутбуком. Если принесете жесткий диск, вам хорошо заплатят." , Time=0)
[97_CHI_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Поняли, Элис. Найти ноутбук. Займемся. Конец связи." , Time=0)
[98_CHI_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
