[173_CHI_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="СЕЙЛЕМ: Что нам, блять, теперь делать?" , Time=0)
[174_CHI_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
