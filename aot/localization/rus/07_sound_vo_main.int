Subtitles[0]=(Text="МЮРРЕЙ: Что вы делаете??!! Поднимите уровень воды! Прием." , Time=0)
[76A_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
