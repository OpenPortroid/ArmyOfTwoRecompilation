bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Так, ребята, я нашла расписание. Скоро к вам подойдет поезд. Запрыгивайте на него - другого способа выбраться оттуда я не вижу. Прием." , Time=0)
