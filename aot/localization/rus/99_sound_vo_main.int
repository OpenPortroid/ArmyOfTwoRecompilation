bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151348"
Subtitles[0]=(Text="МЮРРЕЙ: Там должна быть флешка. Принесите ее, и мы заплатим." , Time=0)
[Murray_info_obj_coll_lapt_1 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151348"
Subtitles[0]=(Text="МЮРРЕЙ: Эй. Где-то рядом должен быть ноутбук. Заберите его, информация на нем стоит дорого." , Time=0)
[Murray_info_obj_coll_lapt_2 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151348"
