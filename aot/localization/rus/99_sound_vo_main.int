[Murray_cmnt_othr_team_1 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151348"
Subtitles[0]=(Text="МЮРРЕЙ: Не понимаю, что происходит. Похоже, компания прислала вторую группу. Сегодня придется попотеть ради денег!" , Time=0)
[Murray_cmnt_othr_team_2 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151348"
Subtitles[0]=(Text="МЮРРЕЙ: Похоже, ебаный Далтон прислал вторую группу! Я же говорила ему, что вы справитесь! Что ж, лучше вам их опередить!" , Time=0)
[Murray_cmnt_othr_team_3 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151348"
Subtitles[0]=(Text="МЮРРЕЙ: Не могу поверить! Я сказал Далтону, что вы справитесь сами, а он прислал еще одну группу. Не дайте им закончить задание раньше вас!" , Time=0)
[Murray_cmnt_wait_1 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151348"
Subtitles[0]=(Text="МЮРРЕЙ: Парни, подождите секунду!" , Time=0)
[Murray_cmnt_wait_2 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
