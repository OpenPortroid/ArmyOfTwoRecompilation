[Murray_info_obj_coll_lapt_3 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151348"
Subtitles[0]=(Text="МЮРРЕЙ: Парни, если найдете один из их ноутбуков, получите от меня большую премию!" , Time=0)
[Murray_info_obj_coll_maps_1 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151348"
Subtitles[0]=(Text="МЮРРЕЙ: Парни, поищите карты! Заплатим, если принесете!" , Time=0)
[Murray_info_obj_coll_maps_2 SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151348"
Subtitles[0]=(Text="МЮРРЕЙ: Хватайте все карты, что увидите поблизости. Мы хорошо за них заплатим!" , Time=0)
