[183_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Спасибо, друг. Еще свяжемся. Конец связи." , Time=0)
[19_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="СЕЙЛЕМ: Знаешь, они хотят заменить всю армию" , Time=0)
Subtitles[1]=(Text="СЕЙЛЕМ: такими наемниками, как мы." , Time=1.85)
[19_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Э... Выглядит хуже, чем есть. Я в порядке." , Time=0)
Subtitles[1]=(Text="ЭЙЗЕНХАУЭР: Сколько прошло, лет десять?" , Time=2.19)
[20_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="РИОС: Его не примут. Про такое дерьмо" , Time=0)
Subtitles[1]=(Text="РИОС: вечно болтают, но его никогда не принимают." , Time=2.07)
[20_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Больше. С самого Сомали." , Time=0)
[206_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Так. Где этот тип?" , Time=0)
[207_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Выходи, выходи, где бы ты ни был..." , Time=0)
[208_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ты всегда был таким ребенком - или у тебя просто какое-то \"второе детство\"?" , Time=0)
[209_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Вот он!" , Time=0)
[21_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Вот обязательно тебе мне все обосрать?" , Time=0)
[210_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Наконец-то!" , Time=0)
[211_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
