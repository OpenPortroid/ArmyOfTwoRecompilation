[103_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Что это было?" , Time=0)
[104_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Риос, Сейлем, мне только что сообщили, что армия США нашла" , Time=0)
Subtitles[1]=(Text="МЮРРЕЙ: источник радиопередачи" , Time=1.7)
Subtitles[2]=(Text="МЮРРЕЙ: и выпустила по зданию управляемую ракету." , Time=4.2)
Subtitles[3]=(Text="МЮРРЕЙ: Вы что-нибудь видели? Прием." , Time=6.4)
[105_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Да -" , Time=0)
[106_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Мы слышали. Прием." , Time=0)
[107_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Ладно, тогда это ваша цель. Обыщите место удара, ищите любые следы Али Юсуфа. Конец связи." , Time=0)
[112_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Может, попробуем пробраться через крышу." , Time=0)
[113_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Спорим, через крышу можно попасть внутрь." , Time=0)
[121a_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="МЮРРЕЙ: Достаньте этот вертолет. Там один из помощников Али Юсуфа!" , Time=0)
Subtitles[1]=(Text="МЮРРЕЙ: Не дайте ему уйти!" , Time=2.67)
[137_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Вертолет на мне - займись теми, кто на земле." , Time=0)
[14_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="СЕЙЛЕМ: Тут все разнесено в хлам." , Time=0)
Subtitles[1]=(Text="СЕЙЛЕМ: Ты правда думаешь, что Эйзенхауэр где-то здесь?" , Time=1.52)
[141_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Не дай вертолету уйти - этих я беру на себя." , Time=0)
[145_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Тайс, держи этих от меня подальше - вертолет на мне!" , Time=0)
[147_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Тут я справлюсь - не дай вертолету уйти!" , Time=0)
[149_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Есть!" , Time=0)
[15_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Не похоже, но давай осмотримся." , Time=0)
[150_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Блять. Он ушел." , Time=0)
[151_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="05_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Ненавижу, когда так бывает." , Time=0)
[152_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="МЮРРЕЙ: Риос, Сейлем, хорошие новости." , Time=0)
Subtitles[1]=(Text="Кто-то из того вертолета позвонил по мобильному самому Али Юсуфу." , Time=1.71)
Subtitles[2]=(Text="Я отследила звонок и выяснила, где Юсуф." , Time=5.44)
Subtitles[3]=(Text="Он на иракской военной базе в паре километров от вас." , Time=8.51)
Subtitles[4]=(Text="Сейчас отмечу ее у вас на GPS. Прием." , Time=11.85)
[153_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Отлично, выдвигаемся! Конец связи." , Time=0)
[154_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Знаешь, я тут подумал. Как мы тогда попали в засаду? Мы на шифрованных частотах. Где мы, знали только SSC и штаб армии." , Time=0)
[155_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Не знаю. И знать не хочу." , Time=0)
[156_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Про такие засады каждый день в новостях говорят. По-моему, кто-то сливает им, где наши войска." , Time=0)
[16_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Слыхал про законопроект, о котором все говорят?" , Time=0)
[16_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="РИОС: Сэм, это ты? Бля, это же я, Тайсон Риос!" , Time=0)
[161_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Ты и твои теории заговора. Ну ты и фрукт, Тайс." , Time=0)
[166_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Похоже, мы нашли базу Али Юсуфа." , Time=0)
[167_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: С чего ты взял? Охрана, оружие, вышки? Или ты у нас ебаный экстрасенс?" , Time=0)
[168_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Зови меня мисс Клео!" , Time=0)
[169_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 152426"
Subtitles[0]=(Text="МЮРРЕЙ: Ребята, еще хорошие новости. Оказывается, коалиция" , Time=0)
Subtitles[1]=(Text="МЮРРЕЙ: давно искала базу Али Юсуфа" , Time=2.63)
Subtitles[2]=(Text="МЮРРЕЙ: - и вы нашли ее первыми." , Time=4.9)
Subtitles[3]=(Text="МЮРРЕЙ: В бункере на базе производят оружие." , Time=6.6)
Subtitles[4]=(Text="МЮРРЕЙ: Минобороны хорошо заплатит, если вы его уничтожите. Прием." , Time=9)
[17_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Какой еще \"законопроект\"?" , Time=0)
[17_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Не думал, что еще тебя увижу!" , Time=0)
[170_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Отлично. Меня это устраивает!" , Time=0)
[171_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Я так и думала. И это еще не все. У нас будет наготове истребитель, так что если понадобится помощь с врагами, просто поставьте радиомаяк на нужную цель, и мы вызовем самолет. Ясно? Конец связи." , Time=0)
[171e_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Отвлеки их. Я поставлю радиомаяк и вызову авиаудар." , Time=0)
[171f_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Так, Элис, маяк установлен. Можешь вызвать авиаудар? Прием." , Time=0)
[171g_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Сделаю, Тайсон. Уходите оттуда. Конец связи!" , Time=0)
[171h_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Займи их, бро. Я поставлю радиомаяк и вызову авиаудар." , Time=0)
[171i_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Элис, можешь вызывать авиаудар. Радиомаяк на месте. Прием." , Time=0)
[171j_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Без проблем, Эллиот. Убирайтесь из-под удара. Конец связи." , Time=0)
[171k_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ебать - они реально это сделали!" , Time=0)
[171l_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Вот за это и налоги платить не жалко." , Time=0)
[171m_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="МЮРРЕЙ: Ребята! Али Юсуф бежит к вертолету." , Time=0)
Subtitles[1]=(Text="МЮРРЕЙ: Не дайте ему сбежать!" , Time=2.08)
[172_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Достань вертолет - он уходит." , Time=0)
[173_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Нет!" , Time=0)
[174_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Только не опять." , Time=0)
[175_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Этот тип мотается туда-сюда, как священник по детским садам." , Time=0)
[176_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="СЕЙЛЕМ: Этого парня найти труднее, чем трусы Бритни." , Time=0)
[177_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Что ты сейчас сказал?" , Time=0)
[178_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Элис, можешь выяснить, куда летит этот вертолет? Прием." , Time=0)
[179_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Уже выяснила. Он только что сел на маленьком острове к югу от вас - возле нефтезавода. Прием." , Time=0)
[18_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: О приватизации армии." , Time=0)
[18_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ты в порядке?" , Time=0)
[180_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Вас понял. Выдвигаемся. Конец связи." , Time=0)
[181_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152426"
Subtitles[0]=(Text="РИОС: Йо, Восьмерка. Слушай. Мне нужна твоя помощь. Слышал про все эти засады в Ираке и Афганистане? Так вот, я думаю, кто-то сливает врагу позиции наших войск. Поищи все, что исходит от армии или от частных подрядчиков с доступом к таким данным. Поможешь?" , Time=0)
[181A_OIL_S3kShUn8 SoundNodeWave]
