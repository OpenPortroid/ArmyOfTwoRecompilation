[219_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Ненадолго... Ненадолго, бро." , Time=0)
[221_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Да, блять! Это тебе за Эйзенхауэра." , Time=0)
[222_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Не дайте ему добраться до вертолета." , Time=0)
[223_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Не дадим, не волнуйся." , Time=0)
[224_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="МЮРРЕЙ: Риос, Сейлем. Вы справились." , Time=0)
Subtitles[1]=(Text="МЮРРЕЙ: Я знала, что вы не подведете. Конец связи." , Time=1.67)
[229_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152426"
Subtitles[0]=(Text="РИОС: Знаешь, у меня все крутятся в голове его слова - что у компании нет морали, что армии должны быть у государств, а не у компаний, понимаешь? И меня это тревожит, брат. Я не всем в SSC доверяю." , Time=0)
[23_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Да, вряд ли я смогу идти, брат. Не против меня понести?" , Time=0)
[230_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152426"
Subtitles[0]=(Text="СЕЙЛЕМ: Как вернемся в Багдад, возьмем пива, может, заглянем в кальянную. Поверь, одна ночь со мной в Зеленой зоне - и ты забудешь обо всем этом." , Time=0)
[231_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Да. Может, ты и прав." , Time=0)
[24_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ты эту херню на ходу выдумываешь?" , Time=0)
[24_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Держу, дружище." , Time=0)
[25_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Они взорвали нашу машину. На базе остался хоть какой-то рабочий транспорт?" , Time=0)
[26_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Недалеко от периметра стоит танк M1." , Time=0)
Subtitles[1]=(Text="ЭЙЗЕНХАУЭР: Он должен быть на ходу." , Time=2)
[27_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ладно. Возьмем его." , Time=0)
[30_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Не могу поверить, что они достали Эйзенхауэра." , Time=0)
[31_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Это просто несправедливо, понимаешь. У него дома жена и дети. Кажется, это нас должны были убить, а не его." , Time=0)
[31_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Эй, Сэм, это я, Эллиот - из рейнджеров!" , Time=0)
[32_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Может, и надо было тебя..." , Time=0)
[32_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Не думал, что еще тебя увижу! Все такой же сучонок, ты погляди!" , Time=0)
[33_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Думаешь, он что-то знал?" , Time=0)
[33_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Ты в порядке, брат?" , Time=0)
[34_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Кто?" , Time=0)
[34_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Э... Выглядит хуже, чем есть. Все будет нормально. Сколько прошло, лет десять?" , Time=0)
[35_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Эйзенхауэр - думаешь, поэтому его и убили?" , Time=0)
[35_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Больше. Еще с Сомали, брат." , Time=0)
[36_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Ты что, спятил, брат?" , Time=0)
[37_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Они целились именно в него. Знали, что он в том вертолете. Он что-то знал. Они не могли дать ему вернуться на базу." , Time=0)
[38_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Кто «они»? Что ты носишься со своими теориями заговора? Он оказался не в том месте не в то время - вот и все." , Time=0)
[38_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Да, вряд ли я смогу идти, брат. Не против меня понести?" , Time=0)
[39_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Ладно, держу." , Time=0)
[40_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Слушай, надо тебя отсюда вытаскивать, а они взорвали нашу машину. Не знаешь, на базе остался рабочий транспорт?" , Time=0)
[41_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Недалеко от периметра стоит танк M1." , Time=0)
Subtitles[1]=(Text="ЭЙЗЕНХАУЭР: Он должен быть на ходу." , Time=2.33)
[42_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Ладно. Возьмем его." , Time=0)
[45_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="05_sound_vo_main"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Кто-нибудь из вас еще общается с кем-то из нашего отряда?" , Time=0)
[46_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="05_sound_vo_main"
Subtitles[0]=(Text="РИОС: Только с Далтоном. Он наш босс в SSC." , Time=0)
[50_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152426"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Все трое перешли на темную сторону, да? Надо было и мне, блять, так сделать, вот что я скажу, потому что у нас одно ебаное барахло из вторых рук. И чуть ли не через день кто-то из моих знакомых гибнет в одной из этих сраных засад." , Time=0)
[51_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Говорят, армия больше не нужна. Частные фирмы все сделают сами." , Time=0)
[52_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Скажу тебе прямо. Если твоя армия зарабатывает на каждой войне, войн станет намного больше, приятель. Я такого будущего не хочу." , Time=0)
[53_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Берегись!" , Time=0)
[54_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Блять! Они перекрыли дорогу." , Time=0)
[55_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Опять засада?" , Time=0)
[56_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Похоже на то." , Time=0)
[57_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Не знаю, как они всегда узнают, где мы, но в последнее время мы попадаем в засаду раз в неделю." , Time=0)
[59_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Эта жара меня доконает." , Time=0)
[59_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Риос, Сейлем, что вы делаете?" , Time=0)
[60_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Это пустыня. Не знаю, чего ты ждал." , Time=0)
[60_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Мы попали в засаду. Дорога перекрыта. Прием." , Time=0)
[61_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Знаю, бро. Я просто говорю. Жарко." , Time=0)
[62_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ты просто ноешь. Ты вечно из-за чего-то ноешь. Меня это достало." , Time=0)
[64_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Пару лет назад мы наткнулись на Дастина, он охранял наркокартель." , Time=0)
[65_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Он работал на наркобарона?" , Time=0)
[66_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Он пошел на нас так, будто мы и знакомы не были." , Time=0)
[67_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Погоди. Пытаюсь это переварить." , Time=0)
Subtitles[1]=(Text="ЭЙЗЕНХАУЭР: То есть вы... Прошу... Вы же не..." , Time=1.83)
[68_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: У нас не было выбора. Либо мы, либо он." , Time=0)
[69_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Вы что, не понимаете, насколько это неправильно? Серьезно, вот поэтому армией должны управлять правительства, а не корпорации." , Time=0)
[75_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Слушайте, простите за ту хрень, что я там наговорил. Вы сегодня отлично поработали." , Time=0)
[76_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Все путем, чувак. Рад был снова увидеть тебя спустя столько лет." , Time=0)
[77_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Да, береги себя, бро." , Time=0)
[78_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ЭЙЗЕНХАУЭР: Вы тоже. Выпьем пива, когда закончится эта война, сукин ты сын." , Time=0)
[79_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Обязательно... Обязательно выпьем!" , Time=0)
[80_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Риос - Мюррею. Задание выполнено. Эйзенхауэр в вертолете. Нам самим идти к точке эвакуации или..." , Time=0)
[81_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Охуеть!" , Time=0)
[82_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Господи..." , Time=0)
[83_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Ч-что случилось?" , Time=0)
[84_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Это вертушка Эйзенхауэра!" , Time=0)
[85_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Вертолет Эйзенхауэра - он только что взорвался!" , Time=0)
[86_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Блять. Я позвоню в Минобороны. Конец связи." , Time=0)
[89_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="МЮРРЕЙ: Мы только что перехватили радиопередачу. Али Юсуф берет на себя ответственность за взрыв вертолета. Мы отследили передачу до деревни рядом с вами." , Time=0)
[93_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: До сих пор не верится, чувак. Эйзенхауэр..." , Time=0)
[94_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Мне тоже, чувак, мне тоже." , Time=0)
[95_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Кроме Далтона, из нашего отряда в живых, считай, только мы и остались." , Time=0)
[96_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: И Педро." , Time=0)
[97_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Четверо из десяти - так себе шансы." , Time=0)
[98_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Война - опасное дело, чувак." , Time=0)
[99_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="05_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Ладно. Так что мы ищем?" , Time=0)
