[212_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Тебе конец!" , Time=0)
[213_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
