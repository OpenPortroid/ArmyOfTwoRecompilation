[141_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ДАЛТОН: Отличная работа. Где-то на объекте еще должны быть боеголовки. Их тоже нужно уничтожить." , Time=0)
[147_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ДАЛТОН: У меня нет времени спорить. Продолжайте задание." , Time=0)
[154_AFG_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
