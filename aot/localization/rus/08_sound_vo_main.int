[135_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Говорит, надо переключить рубильник в диспетчерской лифта на втором уровне. Потом ввести код на посту охраны в вестибюле." , Time=0)
