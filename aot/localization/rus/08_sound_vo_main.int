[163_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="РИОС: Эй, Восьмерка. Можешь проверить камеры наблюдения на верхних этажах? Нам надо узнать, где сейчас Далтон." , Time=0)
