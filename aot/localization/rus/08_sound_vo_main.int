[2_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Да ладно! Как нам до нее добраться?" , Time=0)
[20_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ЧА МИН СУ: Вы разбили мой самолет!?? Вы убили моего пилота!?? Я делаю вам одолжение, и вот как вы мне отплатили?" , Time=0)
[200_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="ЧА МИН СУ: Ну, чего вы ждете? Вон он. Убейте его. Пусть помучается! И его личную охрану тоже убейте!" , Time=0)
[201_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Работаем над этим, Ча Мин. Просто ждем идеального момента для выстрела, понимаешь." , Time=0)
[202_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="ЧА МИН СУ: Вы меня раздражаете... Вот поэтому я не работаю с наемниками." , Time=0)
[203_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Контрактники, Ча Мин. Мы контрактники, а не наемники." , Time=0)
[204_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="ЧА МИН СУ: Ладно. До свидания." , Time=0)
[205_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Это один из тех серверов, о которых говорил Стоквелл. Надо залить его резервную копию на наш FTP-сервер." , Time=0)
[206_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Эй, это один из тех серверов, о которых говорил Стоквелл. Залью его резервную копию на наш FTP." , Time=0)
[207_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Вот еще один сервер." , Time=0)
[208_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Вот еще один сервер, братишка." , Time=0)
[209_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Эй, вот еще один сервер." , Time=0)
[21_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Это не мы. Это Клайд. Он убил пилота и разбил самолет." , Time=0)
[210_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Вот еще один из тех серверов. Залью данные." , Time=0)
[211_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Вот последний сервер." , Time=0)
[212_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Вот последний сервер, братишка." , Time=0)
[212a_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="ЧА МИН СУ: Риос! Сейлем! Это один из личных охранников Клайда! Убейте его!" , Time=0)
[212b_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="ЧА МИН СУ: Вот еще один из личных охранников Клайда! Убейте его!" , Time=0)
[212c_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="ЧА МИН СУ: Риос! Сейлем! Еще один личный охранник Клайда! Убейте его!" , Time=0)
[212d_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="ЧА МИН СУ: Достаньте этого охранника! Достаньте его! Ну же! Убейте его!" , Time=0)
[213_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="КЛАЙД: Хотите получить? Ну давай, иди сюда, жопорылый." , Time=0)
[213a_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="КЛАЙД: Хотите получить? Ну давайте, идите сюда!" , Time=0)
[214_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: \"Жопорылый?\" Кто так вообще говорит?" , Time=0)
[214a_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Клайд полный психопат!" , Time=0)
[215_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Не знаю, что с этим парнем не так, мужик." , Time=0)
[216_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="КЛАЙД: Что, думали, вам медаль дадут за то, что сдали меня и Далтона? Хуй там, все, что вы получите, - это ебаную пулю в вашу ебаную башку." , Time=0)
[217_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="КЛАЙД: Я вас так отделаю," , Time=0)
Subtitles[1]=(Text="КЛАЙД: что родная мамка не узнает." , Time=2.19)
[218_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Эй, мою маму не трогай." , Time=0)
[219_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="КЛАЙД: Я убью вас обоих, вскрою и пойду на аэробику в ваших кишках вместо гетр!" , Time=0)
[219a_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="08_sound_vo_main"
Subtitles[0]=(Text="КЛАЙД: Я с огромным удовольствием вас прикончу!" , Time=0)
[22_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="ЧА МИН СУ: Клайд? Кто такой Клайд?" , Time=0)
[220_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Нет, ну это вообще имеет смысл?" , Time=0)
[221_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="КЛАЙД: Я убью вас обоих. Потом выпущу из вас всю кровь, выну кости, посажу ваши тела в большое кресло с эльфами и оленями, сяду вам на колени и расскажу, какое крутое дерьмо хочу на Рождество." , Time=0)
[221a_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="08_sound_vo_main"
Subtitles[0]=(Text="КЛАЙД: Когда я с вами закончу, вас, двух уебков, вся королевская конница и вся королевская рать обратно не соберут!" , Time=0)
[222_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: У этого парня явно было паршивое детство." , Time=0)
[223_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Думаешь?" , Time=0)
[223A_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="КЛАЙД: Это еще не конец!" , Time=0)
[224_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Хотел бы я посмотреть, как он от такого оправится." , Time=0)
[225_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Братишка, без шансов. Он МЕРТВ." , Time=0)
[226_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="ЧА МИН СУ: Наконец-то. Вы убили его. Я переведу вам кое-что особенное на банковский счет в знак благодарности. До свидания." , Time=0)
[227_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Теперь осталось только достать Далтона!" , Time=0)
[228_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Далтон прямо за этими дверями. Готов?" , Time=0)
[229_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Ага. Готов." , Time=0)
[23_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Филлип Клайд. Работает на SSC." , Time=0)
[230_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Готов прикончить Далтона?" , Time=0)
[231_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ага. Пошли." , Time=0)
[232_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Блять. Он уходит." , Time=0)
[233_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Нет. Не уйдет. Давай." , Time=0)
[234_MIA_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="ДАЛТОН: Помните Сомали? Весь наш отряд был прижат огнем. Люди Мо'Алима шли нас добивать. Это был единственный раз в жизни, когда я по-настоящему потерял надежду, когда мне было по-настоящему страшно. Но вы двое... Думаю, вы так и не поняли, сколько жизней спасли в тот день, что вы сделали для нашего отряда и как я вами гордился. И я смотрю на вас сейчас, после всего этого..." , Time=0)
[235_MIA_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="ДАЛТОН: И я знаю, вы сильно повзрослели за эти пятнадцать лет. Но вы все еще мои ребята. Вы все еще лучшие из лучших, потому что я научил вас быть лучшими. Мы через многое прошли втроем. И мне... мне будет вас не хватать." , Time=0)
[236_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Может, уложим его?" , Time=0)
[237_MIA_STOCKWELL SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="СТОКВЕЛЛ: Вы дали ему уйти. Это была большая ошибка." , Time=0)
[238_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Опрос показал:" , Time=0)
[239_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ты труп." , Time=0)
[24_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="ЧА МИН СУ: Ох... Ненавижу этого уебка." , Time=0)
[240_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Давай, валим отсюда." , Time=0)
[25_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="ЧА МИН СУ: Вот что. Я пришлю вертолет, он заберет вас с крыши аэропорта. Найдите на вертолете этого уебка Клайда и убейте его для меня. И еще: если увидите личных охранников Клайда, их тоже убейте!" , Time=0)
[26_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Но Клайд..." , Time=0)
[27_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="СЕЙЛЕМ: ...смоется. Мы его тебе достанем." , Time=0)
[28_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="ЧА МИН СУ: Ах да... Если и мой вертолет разобьете, я вам лично ваши ебаные яйца отрежу. До свидания." , Time=0)
[28a_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="ЧА МИН СУ: Ах да... Если и мой вертолет разобьете, я убью вас голыми руками. Медленно... До свидания." , Time=0)
[29_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ты что делаешь, мужик? Клайд погиб в авиакатастрофе." , Time=0)
[2A_MIA_S3kShUn8 SoundNodeWave]
bAlwaysLocalise=False
bManualWordWrap=True
Comment="cl# 150714"
Subtitles[0]=(Text="s3kShUn8: |00k f0r 73h doub|3 d00r5 0n 7eh 70p f|00r." , Time=0)
Subtitles[1]=(Text="s3kShUn8: -S8" , Time=2)
[3_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Он сказал, Мюррей держат здесь, в аэропорту. Она в багажном отделении. Нам надо искать двустворчатые двери на верхнем этаже." , Time=0)
[30_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Расслабься, мужик. Все будет нормально." , Time=0)
[31_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="СЕЙЛЕМ: Ты глянь! Похоже, Далтон" , Time=0)
Subtitles[1]=(Text="СЕЙЛЕМ: натравил на нас всю компанию." , Time=1.43)
[32_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Скажи спасибо, что нам пока не пришлось драться ни с кем из друзей." , Time=0)
[33_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Ага. Это был бы отстой." , Time=0)
[34_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Эй, Восьмой. Слышишь меня? Ворота в багажное отделение закрыты. Можешь что-нибудь сделать?" , Time=0)
[34A_MIA_S3kShUn8 SoundNodeWave]
bAlwaysLocalise=False
bManualWordWrap=True
Comment="cl# 150714"
Subtitles[0]=(Text="s3kShUn8: 1 c4n 0p3n 7h3m r3m073|y. H4n6 0n." , Time=0)
Subtitles[1]=(Text="s3kShUn8: -S8" , Time=2)
[35_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Он откроет ворота удаленно." , Time=0)
[36_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Риос! Сейлем! Я здесь, наверху!" , Time=0)
[37_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Элис. Ты в порядке?" , Time=0)
[38_MIA_SSC_GUARD SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="НАЕМНИК: Заткнись, сука!" , Time=0)
[39_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Поднимайтесь сюда, черт возьми! Скорее, прошу!" , Time=0)
[4_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Верхний этаж, двустворчатые двери. Понял." , Time=0)
[40_MIA_SSC_GUARD SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="НАЕМНИК: Я сказал, заткни пасть!" , Time=0)
[41_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: А-а-а!! Блять! Блять! Блять!" , Time=0)
[42_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="МЮРРЕЙ: Давайте, ребята!" , Time=0)
Subtitles[1]=(Text="МЮРРЕЙ: Надо подтолкнуть трап к этой камере." , Time=1.25)
[43_MIA_SSC_GUARD SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="НАЕМНИК: Сдохнуть хочешь, сука?" , Time=0)
[44_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Сука, трап уперся в ту дверь." , Time=0)
[45_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Тогда давай попробуем сдвинуть дверь!" , Time=0)
[45A_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Дверь вон там, наверху!" , Time=0)
[45B_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Дверь впереди, за мной." , Time=0)
[46_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Порядок. Дверь больше не мешает. Давай вместе толкать трап." , Time=0)
[47_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Элис. Ты в порядке? Что они с тобой сделали?" , Time=0)
[48_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Ого, Элис. Что они с тобой сделали?" , Time=0)
[49_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Лучше вам не знать." , Time=0)
[5_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="СЕЙЛЕМ: Мужик, Ча Мин Су будет в бешенстве," , Time=0)
Subtitles[1]=(Text="СЕЙЛЕМ: когда узнает, что мы разбили его самолет." , Time=2.1)
[50_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Вытащите меня отсюда?!" , Time=0)
[51_08_hint_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Давай снимем этих двух охранников одновременно." , Time=0)
[51_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Ну же, ребята, вытащите меня отсюда!" , Time=0)
[52_08_hint_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Видишь тех охранников? Давай снимем их вместе." , Time=0)
[52_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Вытащите меня отсюда к черту, ребята!" , Time=0)
[53_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Спасибо." , Time=0)
[54_MIA_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Все всегда говорили, что если бы я не пошел в SSC, то давно бы сидел в тюрьме. Мама так гордилась, что я получил эту работу, зарабатываю деньги. А теперь мы, наверное, все равно сядем в тюрьму из-за этой истории с Уайтхорсом." , Time=0)
[54_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Я не могу встать. Кто-нибудь из вас может меня понести?" , Time=0)
[55_MIA_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="РИОС: Найдем выход. Стоквелл нас прикроет." , Time=0)
[55_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Держу тебя. Все будет хорошо." , Time=0)
[56_MIA_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Ты с ним и парой слов не перекинулся. С чего ты взял, что он нам поможет?" , Time=0)
[56_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Держу тебя, Элис." , Time=0)
[56a_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="МЮРРЕЙ: Эй, я не успела вам сказать," , Time=0)
Subtitles[1]=(Text="но когда я во всем разобралась," , Time=3.6)
Subtitles[2]=(Text="я перевела часть денег SSC для вас на офшорный счет." , Time=4.8)
Subtitles[3]=(Text="Что-то вроде прощального подарка от компании." , Time=8.7)
Subtitles[4]=(Text="Как только доберусь до Интернета," , Time=11.1)
Subtitles[5]=(Text="переведу их на ваши счета." , Time=13.3)
Subtitles[6]=(Text="Вы их заслужили!" , Time=15.2)
[57_MIA_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="РИОС: Обязан. Иначе нам пиздец." , Time=0)
[57_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Эй, Восьмой, нам надо открыть эти ворота!" , Time=0)
[57A_MIA_S3kShUn8 SoundNodeWave]
bAlwaysLocalise=False
bManualWordWrap=True
Comment="cl# 150714"
Subtitles[0]=(Text="s3kShUn8: W0rk1n9 0n 17!" , Time=0)
Subtitles[1]=(Text="s3kShUn8: -S8" , Time=1)
[58_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Спасибо, мужик." , Time=0)
[59_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Вы должны остановить Далтона. Он собирается убить Стоквелла." , Time=0)
[6_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Этот самолет стоил двадцать миллионов баксов, не меньше. Он нас закажет." , Time=0)
[60_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Какая нам разница, убьет он Стоквелла или нет? Этот тип нас подставил." , Time=0)
[61_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="МЮРРЕЙ: Нет. Это был не он. Стоквелл, может, и знал, что Далтон" , Time=0)
Subtitles[1]=(Text="нарушает кое-какие правила, но не знал, что тот подвергает опасности войска США," , Time=2.88)
Subtitles[2]=(Text="чтобы SSC хорошо выглядела. Когда убили сенатора Уайтхорса," , Time=6.7)
Subtitles[3]=(Text="Стоквелл все узнал и попытался сдать Далтона федералам." , Time=10.78)
[62_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Хочешь сказать, Далтон - главный мозг всего этого?" , Time=0)
[63_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Да. Он выдавал позиции войск и лоббировал в Конгрессе приватизацию армии. Стоквелла он держит при себе только для того, чтобы тот принял удар на себя, если кто-нибудь узнает." , Time=0)
[64_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="СЕЙЛЕМ: И что будет, если этот закон примут" , Time=0)
Subtitles[1]=(Text="СЕЙЛЕМ: и армию правда приватизируют?" , Time=1.69)
[65_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="МЮРРЕЙ: SSC станет самой мощной военной силой в мире. Далтон убьет Стоквелла и выставит все как несчастный случай. А потом сам возглавит SSC и будет творить ужасные вещи." , Time=0)
[66_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Например?" , Time=0)
[67_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: Держать страны в заложниках, развязывать войны ради прибыли - все, что захочет." , Time=0)
[68_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="МЮРРЕЙ: Вы должны спасти Стоквелла. Только он может доказать, что вы невиновны. А Далтона вы должны убить, иначе он убьет вас." , Time=0)
[69_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ладно. Сделаем." , Time=0)
[69a_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Это один из личных охранников Клайда." , Time=0)
[69b_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Разве Ча Мин Су не говорил, что заплатит нам, если мы уберем этих парней?" , Time=0)
[69c_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ага. Говорил." , Time=0)
[69d_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Эй, этот парень из личной охраны Клайда." , Time=0)
[69e_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="РИОС: А, точно - Ча Мин Су обещал заплатить нам за этих ребят." , Time=0)
[7_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="СЕЙЛЕМ: Да ну, брось. Он бы так не поступил." , Time=0)
[70_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Помоги с воротами." , Time=0)
[71_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="РИОС: Эллиот - помоги с воротами!" , Time=0)
[72_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="РИОС: Давай, приятель. Помоги с этими чертовыми воротами!" , Time=0)
[73_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Помоги поднять ворота!" , Time=0)
[74_MIA_SALEM SoundNodeWave]
