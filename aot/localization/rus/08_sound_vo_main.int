[89_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Вон электростанция!" , Time=0)
[9_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Да, но он же наш парень. Мы с ним близки. Он не пойдет на такие крайности." , Time=0)
[90_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
