[157_MIA_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="ДАЛТОН: Собрались на верхние этажи? Не выйдет, если я могу помешать. Вы, парни, не понимаете, что ваша выходка - убийство сенатора - может бросить тень на SSC. А я никому не позволю бросить тень на SSC." , Time=0)
