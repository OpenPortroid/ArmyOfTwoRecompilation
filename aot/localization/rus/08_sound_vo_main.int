[92_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Не могу добраться до рубильников монорельса - в воде провода. Отключи питание, чтобы я смог пройти." , Time=0)
[93_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Вот дерьмо, приятель. В воде провода. Отключи питание, чтобы я смог перебраться и найти рубильник монорельса." , Time=0)
[93A_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
