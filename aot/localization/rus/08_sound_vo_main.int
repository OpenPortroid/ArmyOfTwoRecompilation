[112_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="ЧА МИН СУ: Вы уже убили этого уебка Клайда?" , Time=0)
[113_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Нет... Слушай, Ча..." , Time=0)
[114_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="ЧА МИН СУ: Ха-ха-ха. Шучу. Я знаю, что вы еще не нашли Клайда. Знаете, откуда я знаю?" , Time=0)
[115_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Э-э-э..." , Time=0)
[116_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="ЧА МИН СУ: Я взломал камеры на ваших шлемах. Теперь я сам увижу, как вы убьете Клайда. Но если проебетесь - это я тоже увижу! До свидания." , Time=0)
[117_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Зря ты соврал Ча Мин Су. Нам пиздец, когда он узнает, что Клайд погиб в авиакатастрофе." , Time=0)
[118_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Расслабься, чувак. Что-нибудь придумаем." , Time=0)
[119_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Ты всегда так говоришь... И никогда ничего не придумываем." , Time=0)
[12_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="РИОС: Да ты прямо комик, Эллиот." , Time=0)
[120_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Так. Наша остановка!" , Time=0)
[121_MIA_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="ДАЛТОН: Ну что, парни, залезли в осиное гнездо?" , Time=0)
Subtitles[1]=(Text="ДАЛТОН: Жаль, что все мои люди знают: вы взяли контракт" , Time=3.37)
Subtitles[2]=(Text="ДАЛТОН: у террористов на убийство сенатора США." , Time=5.43)
Subtitles[3]=(Text="ДАЛТОН: Видите ли, мои люди - хорошие ребята." , Time=8.24)
Subtitles[4]=(Text="ДАЛТОН: Они не дадут таким убийцам, как вы," , Time=10.1)
Subtitles[5]=(Text="ДАЛТОН: выйти из этого здания живыми." , Time=11.6)
[122_MIA_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="ДАЛТОН: Мне жаль, что до этого дошло." , Time=0)
Subtitles[1]=(Text="ДАЛТОН: Мне нравилось работать с вами обоими." , Time=2.7)
Subtitles[2]=(Text="ДАЛТОН: Но вот что бывает -" , Time=5.01)
Subtitles[3]=(Text="ДАЛТОН: когда пытаешься вершить правосудие сам." , Time=6.84)
[123_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Поверить не могу, что он был нашим другом." , Time=0)
[124_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Знаешь, как говорят - власть развращает." , Time=0)
[125_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Ага - он обожает власть. Спорим на что угодно, он сидит на верхнем этаже за своим дорогущим столом в большом угловом кабинете и ждет нас." , Time=0)
[126_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
