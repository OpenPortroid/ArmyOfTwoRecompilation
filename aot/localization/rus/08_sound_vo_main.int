[77_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Недалеко? Давай сядем на крышу." , Time=0)
[78_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Это вертолет Ча Мин Су, я не буду так рисковать." , Time=0)
[79_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="МЮРРЕЙ: Если вы не достанете Далтона, он придет за мной." , Time=0)
[8_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="РИОС: Этот тип - торговец оружием на черном рынке. Он, наверное, каждый день кого-нибудь заказывает." , Time=0)
[80_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Не волнуйся. Мы его достанем." , Time=0)
[81_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="МЮРРЕЙ: И не дайте ему убить Стоквелла!" , Time=0)
[82_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Нам нужно попасть в башню." , Time=0)
[83_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Похоже, придется искать другой путь внутрь." , Time=0)
[84_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Другого пути внутрь нет." , Time=0)
[85_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Да ладно тебе. Кто ищет, тот всегда найдет - может, на монорельсе?" , Time=0)
[86_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="РИОС: Я думал об этом. Но монорельс обесточен." , Time=0)
[87_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Можно пойти на электростанцию и снова включить питание." , Time=0)
[88_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
