[93B_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="СЕЙЛЕМ: Тайс, мне нужно питание, чтобы открыть дверь. Можешь снова его включить?" , Time=0)
[94_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
