[SE_L10_081_DALTON_006 SoundNodeWave]
Subtitles[0]=(Text="ДАЛТОН: Что ж, вы пришли вовремя." , Time=0)
Subtitles[1]=(Text="Я одет для игры и экипирован для бойни." , Time=2)

[SE_L10_082_DALTON_007 SoundNodeWave]
