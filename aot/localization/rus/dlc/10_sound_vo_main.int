[SE_L10_075_RIOS_020 SoundNodeWave]
Subtitles[0]=(Text="РИОС: Класс, Элис! Сообщим, когда дело будет сделано." , Time=0)

[SE_L10_076_MURRAY_023 SoundNodeWave]
Subtitles[0]=(Text="МЮРРЕЙ: Задайте ему жару. Конец связи." , Time=0)

[SE_L10_077_RIOS_021 SoundNodeWave]
