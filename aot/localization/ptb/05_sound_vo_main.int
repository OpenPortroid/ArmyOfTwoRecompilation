bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: O que te deu essa ideia? Os guardas, as armas, as torres? Ou você é um maldito vidente?" , Time=0)
[168_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
