bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="EISENHOWER: Nunca pensei que veria você de novo! Continua uma mariquinha, olha só pra você!" , Time=0)
[33_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Você acha que ele sabia de alguma coisa?" , Time=0)
[33_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Tá tudo bem, cara?" , Time=0)
[34_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Quem?" , Time=0)
[34_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="EISENHOWER: Ah... Parece pior do que é. Eu fico bem. Quanto tempo faz, uns dez anos?" , Time=0)
[35_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Eisenhower - você acha que foi por isso que mataram ele?" , Time=0)
[35_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Mais. Desde lá na Somália, cara." , Time=0)
[36_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Tá maluco, cara?" , Time=0)
[37_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Eles escolheram ele. Sabiam que ele estava naquele helicóptero. Ele sabia de alguma coisa. Não podiam deixar ele voltar pra base." , Time=0)
[38_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Quem são 'eles'? Qual é a sua com essas teorias da conspiração? Ele estava no lugar errado na hora errada - simples assim." , Time=0)
[38_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="EISENHOWER: É, acho que não consigo andar, cara. Se importa de me carregar?" , Time=0)
[39_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Beleza, pode deixar." , Time=0)
[40_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Ei, a gente precisa te tirar daqui e explodiram nosso veículo. Sabe se sobrou algum veículo funcionando nessa base?" , Time=0)
[41_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="EISENHOWER: Tem um tanque M1 perto do perímetro." , Time=0)
Subtitles[1]=(Text="EISENHOWER: Ainda deve estar funcionando." , Time=2.33)
[42_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Beleza. Vamos usar esse." , Time=0)
[45_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="05_sound_vo_main"
Subtitles[0]=(Text="EISENHOWER: Algum de vocês ainda tem contato com alguém da nossa unidade?" , Time=0)
[46_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="05_sound_vo_main"
Subtitles[0]=(Text="RIOS: Só o Dalton. Ele é nosso chefe na SSC." , Time=0)
[50_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152426"
Subtitles[0]=(Text="EISENHOWER: Os três foram pro lado negro, né? Eu devia ter feito a mesma porra, tô te falando, porque a gente só tem equipamento de segunda mão de merda. E parece que a cada dois dias morre alguém que eu conheço numa dessas emboscadas." , Time=0)
[51_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Dizem que a gente não precisa mais de Exército. Empresas privadas fazem tudo." , Time=0)
[52_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="EISENHOWER: Deixa eu te falar uma coisa bem claro. Se a sua força de combate ganha dinheiro toda vez que tem guerra, você vai ver muito mais guerra, parceiro. Esse não é o futuro que eu quero ver." , Time=0)
[53_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Cuidado!" , Time=0)
[54_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Merda! Bloquearam o nosso caminho." , Time=0)
[55_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="EISENHOWER: É outra emboscada?" , Time=0)
[56_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Parece que sim." , Time=0)
[57_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="EISENHOWER: Não sei como eles sempre sabem onde a gente tá, mas ultimamente levamos uma emboscada por semana." , Time=0)
[59_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Esse calor tá me matando." , Time=0)
[59_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Rios, Salem, o que vocês estão fazendo?" , Time=0)
[60_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: É o deserto. Não sei o que você esperava." , Time=0)
[60_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Fomos emboscados. A estrada está bloqueada. Câmbio." , Time=0)
[61_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Eu sei, mano. Só tô dizendo. Tá quente." , Time=0)
[62_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Você só reclama. Vive reclamando de alguma coisa. Tô de saco cheio." , Time=0)
[64_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: A gente topou com o Dustin uns anos atrás fazendo segurança pra um cartel de drogas." , Time=0)
[65_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="EISENHOWER: Ele trabalhava pra um traficante?" , Time=0)
[66_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Ele veio pra cima de nós como se nem nos conhecesse." , Time=0)
[67_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="EISENHOWER: Pera aí. Tô tentando processar isso." , Time=0)
Subtitles[1]=(Text="EISENHOWER: Você tá me dizendo que... Por favor... Vocês não..." , Time=1.83)
[68_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: A gente não teve escolha. Era nós ou ele." , Time=0)
[69_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="EISENHOWER: Não vê como isso é errado? Sério, é por isso que as forças armadas devem ser comandadas por governos, não por empresas." , Time=0)
[75_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="EISENHOWER: Escuta, desculpa pela merda que eu disse lá atrás. Vocês mandaram bem hoje." , Time=0)
[76_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Tá tudo certo, cara. Foi bom te ver de novo depois de tantos anos." , Time=0)
[77_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: É, se cuida, mano." , Time=0)
[78_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="EISENHOWER: Vocês também. Vamos tomar uma cerveja quando essa guerra acabar, seus filhos da puta." , Time=0)
[79_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Vamos sim... Vamos sim!" , Time=0)
[80_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Rios para Murray. Missão cumprida. Eisenhower está no helicóptero. Seguimos para a extração por conta própria, ou -" , Time=0)
[81_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Puta merda!" , Time=0)
[82_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Meu Deus..." , Time=0)
[83_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: O-o que aconteceu?" , Time=0)
[84_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Aquele é o helicóptero do Eisenhower!" , Time=0)
[85_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: O helicóptero do Eisenhower acabou de explodir!" , Time=0)
[86_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Merda. Vou ligar pro Departamento de Defesa. Câmbio e desligo." , Time=0)
[89_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="MURRAY: Acabamos de interceptar uma transmissão de rádio. Ali Youssef assumiu a autoria da explosão do helicóptero. Rastreamos a transmissão até uma vila perto da sua posição." , Time=0)
[93_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Ainda não acredito, cara. O Eisenhower..." , Time=0)
[94_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Nem eu, cara, nem eu." , Time=0)
[95_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Fora o Dalton, somos praticamente os únicos vivos do nosso esquadrão." , Time=0)
[96_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Menos o Pedro." , Time=0)
[97_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Quatro de dez, não é uma boa estatística." , Time=0)
[98_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Guerra é um negócio perigoso, cara." , Time=0)
[99_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="05_sound_vo_main"
Subtitles[0]=(Text="SALEM: Beleza. E aí, o que estamos procurando?" , Time=0)
