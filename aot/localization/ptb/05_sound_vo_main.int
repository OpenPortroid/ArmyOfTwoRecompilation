[27_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Beleza. Vamos usar esse." , Time=0)
[30_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Não acredito que pegaram o Eisenhower." , Time=0)
[31_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Não parece certo, sabe? Ele tinha mulher e filhos em casa. Parece que devia ter sido a gente no lugar dele." , Time=0)
