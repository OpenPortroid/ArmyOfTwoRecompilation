bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="MURRAY: Rios, Salem. Vocês conseguiram." , Time=0)
Subtitles[1]=(Text="MURRAY: Eu sabia que vocês dariam conta dessa. Câmbio e desligo." , Time=1.67)
[229_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152426"
Subtitles[0]=(Text="RIOS: Sabe, eu não paro de ouvir as palavras dele na cabeça - sobre a empresa não ter moral, sobre governos terem exércitos, não empresas, sabe? E isso me preocupa, cara; eu não confio em todo mundo na SSC." , Time=0)
[23_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="EISENHOWER: É, acho que não consigo andar, cara. Se importa de me carregar?" , Time=0)
[230_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152426"
Subtitles[0]=(Text="SALEM: Assim que a gente voltar a Bagdá, vamos tomar umas cervejas, quem sabe ir num daqueles bares de narguilé. Confia, uma noite comigo na Zona Verde e você esquece tudo isso." , Time=0)
[231_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: É. Talvez você tenha razão." , Time=0)
[24_OIL_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Você inventa essa merda toda?" , Time=0)
[24_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Tô contigo, amigão." , Time=0)
[25_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Explodiram nosso veículo. Sobrou algum veículo funcionando nessa base?" , Time=0)
[26_OIL_EISENHOWER SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="EISENHOWER: Tem um tanque M1 perto do perímetro." , Time=0)
