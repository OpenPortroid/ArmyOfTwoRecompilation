Subtitles[0]=(Text="RIOS: Entendido. Estamos a caminho. Câmbio e desligo." , Time=0)
[181_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152426"
Subtitles[0]=(Text="RIOS: E aí, Oito. Escuta. Preciso que me ajude com uma coisa. Sabe essas emboscadas que a gente ouve falar no Iraque e no Afeganistão? Pois é. Acho que alguém está vazando a posição das tropas pros nossos inimigos. Quero que procure qualquer coisa saindo do Exército ou dos contratados privados que tenham acesso a esse tipo de informação. Está comigo?" , Time=0)
