[152_OIL_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="MURRAY: Rios, Salem, boas notícias." , Time=0)
Subtitles[1]=(Text="Quem estava naquele helicóptero fez uma ligação de celular pro próprio Ali Youssef." , Time=1.71)
Subtitles[2]=(Text="Consegui rastrear e descobri onde o Youssef está." , Time=5.44)
Subtitles[3]=(Text="Ele está numa base militar iraquiana a alguns quilômetros daqui." , Time=8.51)
Subtitles[4]=(Text="Vou marcar no GPS de vocês. Câmbio." , Time=11.85)
[153_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Ótimo, já estamos indo! Câmbio e desligo." , Time=0)
[154_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Sabe, eu andei pensando. Como fomos emboscados antes? Usamos frequências codificadas. Só a SSC e o QG do Exército sabiam nossa localização." , Time=0)
[155_OIL_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Não sei. Não ligo." , Time=0)
[156_OIL_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Ouvimos falar dessas emboscadas todo dia no noticiário. Acho que alguém está contando pra eles onde estão nossas tropas." , Time=0)
[16_OIL_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Já ficou sabendo desse projeto de lei de que estão falando?" , Time=0)
