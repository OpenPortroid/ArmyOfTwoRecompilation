bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 152426"
Subtitles[0]=(Text="MURRAY: Ei, pessoal, mais uma boa notícia. Acontece que a Coalizão" , Time=0)
Subtitles[1]=(Text="MURRAY: procurava a base do Ali Youssef há muito tempo" , Time=2.63)
Subtitles[2]=(Text="MURRAY: - e vocês foram os primeiros a achar." , Time=4.9)
