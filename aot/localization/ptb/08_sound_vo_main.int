Subtitles[0]=(Text="SALEM: O Clyde é um psicopata total!" , Time=0)
[215_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Não sei qual é o problema desse cara, mano." , Time=0)
[216_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="CLYDE: O que foi, achou que ia ganhar uma medalha por dedurar eu e o Dalton, é? Pois o que vocês vão ganhar é uma porra de uma bala na porra da cabeça." , Time=0)
[217_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="CLYDE: Vou arrebentar vocês de um jeito que" , Time=0)
