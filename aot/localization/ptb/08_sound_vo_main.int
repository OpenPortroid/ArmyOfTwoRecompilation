[3_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Ele disse que a Murray está presa aqui - no aeroporto. Ela está na área de bagagens. A gente tem que procurar umas portas duplas no último andar." , Time=0)
[30_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Relaxa, cara. Vai dar tudo certo." , Time=0)
[31_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="SALEM: Olha só isso! Parece que o Dalton" , Time=0)
Subtitles[1]=(Text="SALEM: está mandando a empresa inteira atrás da gente." , Time=1.43)
[32_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Agradeça por a gente ainda não ter tido que lutar contra nenhum amigo nosso." , Time=0)
[33_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: É. Isso ia ser foda." , Time=0)
[34_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Ei, Eight. Está me ouvindo? Os portões da área de bagagens estão fechados. Dá pra fazer alguma coisa?" , Time=0)
