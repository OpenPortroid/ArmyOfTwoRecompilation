bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="DALTON: Indo pros andares de cima? Só se eu deixar. O que vocês não entendem é que essa palhaçada de matar o senador pode queimar a SSC. E eu não posso deixar ninguém queimar a SSC." , Time=0)
