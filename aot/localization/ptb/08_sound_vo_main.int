[181_MIA_STOCKWELL SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="STOCKWELL: Tenho cópias das provas espalhadas em quatro servidores na sala de arquivos. Vocês podem enviar, mas rápido. O Dalton está lá em cima tentando destruir tudo." , Time=0)
[182_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Certo, e mais uma coisa. Se você está envolvido nessa merda - de qualquer jeito - precisa se entregar. Amigos nossos foram mortos." , Time=0)
[183_MIA_STOCKWELL SoundNodeWave]
