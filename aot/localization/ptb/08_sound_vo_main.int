bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="CHA MIN SOO: Vocês destruíram meu avião!?? Mataram meu piloto!?? Eu faço um favor e é assim que vocês me pagam?" , Time=0)
[200_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="CHA MIN SOO: Bom, o que estão esperando? Ali está ele. Matem ele. Façam ele sofrer! E matem os guarda-costas dele!" , Time=0)
[201_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="SALEM: Estamos trabalhando nisso, Cha Min. Só esperando o tiro perfeito aparecer, sabe." , Time=0)
