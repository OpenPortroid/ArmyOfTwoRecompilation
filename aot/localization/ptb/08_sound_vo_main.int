bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="RIOS: Ei, Eight - Estamos nas portas duplas do quarto andar. Tem algum tipo de trava magnética. Dá pra fazer alguma coisa?" , Time=0)
[170_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
