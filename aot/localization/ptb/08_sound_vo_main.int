[68_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="MURRAY: Vocês têm que salvar o Stockwell. Ele é o único que pode provar que vocês são inocentes. E têm que matar o Dalton, ou ele mata vocês." , Time=0)
