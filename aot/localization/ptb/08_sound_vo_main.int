[61_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="MURRAY: Não. Não foi ele. O Stockwell pode ter sabido que o Dalton" , Time=0)
