[62_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Está dizendo que o Dalton é o cérebro de tudo isso?" , Time=0)
[63_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Sim. Ele vem vazando posições de tropas e pressionando o Congresso a privatizar as Forças Armadas. Só mantém o Stockwell por perto pra ele levar a culpa se alguém descobrir." , Time=0)
[64_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="SALEM: E o que acontece se esse projeto passar" , Time=0)
Subtitles[1]=(Text="SALEM: e eles privatizarem as Forças Armadas?" , Time=1.69)
[65_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="MURRAY: A SSC vira a entidade militar mais poderosa do mundo. O Dalton mata o Stockwell e faz parecer acidente. Aí ele mesmo toca a SSC - e faz coisas terríveis." , Time=0)
[66_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
