[54_MIA_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="SALEM: Todo mundo sempre dizia que, se eu não tivesse entrado na SSC, já estaria preso. Minha mãe ficou tão orgulhosa de eu ter conseguido esse emprego, de ganhar dinheiro. E agora a gente provavelmente vai acabar preso do mesmo jeito por causa dessa história do Whitehorse." , Time=0)
[54_MIA_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Não consigo ficar de pé. Algum de vocês pode me carregar?" , Time=0)
[55_MIA_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="RIOS: A gente dá um jeito de sair dessa. O Stockwell vai nos apoiar." , Time=0)
