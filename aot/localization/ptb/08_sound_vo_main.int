[56_MIA_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="SALEM: Você nunca trocou duas palavras com o cara. Como sabe que ele vai nos ajudar?" , Time=0)
