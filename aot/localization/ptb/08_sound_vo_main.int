[218_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Ei - deixa a minha mãe fora disso." , Time=0)
[219_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="CLYDE: Vou matar vocês dois, abrir vocês no meio e ir pra aula de aeróbica usando suas tripas de aquecedor de perna!" , Time=0)
[219a_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="08_sound_vo_main"
Subtitles[0]=(Text="CLYDE: Vou curtir pra caralho matar vocês!" , Time=0)
[22_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="CHA MIN SOO: Clyde? Quem é Clyde?" , Time=0)
[220_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Quer dizer - isso nem faz sentido, faz?" , Time=0)
[221_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="CLYDE: Vou matar vocês dois. Depois vou drenar todo o sangue, tirar os ossos, botar o corpo numa cadeirona com uns elfos e renas, sentar no colo de vocês e contar todas as coisas legais que eu quero de Natal." , Time=0)
[221a_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="08_sound_vo_main"
Subtitles[0]=(Text=": Quando eu acabar com vocês, nem todos os cavalos e todos os homens do rei vão conseguir juntar vocês dois, filhos da puta, de novo!" , Time=0)
[222_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Esse cara claramente teve uma infância fodida." , Time=0)
[223_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Você acha?" , Time=0)
[223A_MIA_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="CLYDE: Isso não acabou!" , Time=0)
[224_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Queria ver ele voltar dessa." , Time=0)
[225_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Mano - não tem como. Ele está MORTO." , Time=0)
[226_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="CHA MIN SOO: Finalmente. Vocês mataram ele. Vou transferir uma coisinha especial pra conta bancária de vocês, de agradecimento. Tchau." , Time=0)
[227_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Agora só falta pegar o Dalton!" , Time=0)
[228_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: O Dalton está do outro lado dessas portas. Está pronto?" , Time=0)
[229_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Estou. Pronto." , Time=0)
[23_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Phillip Clyde. Ele trabalha pra SSC." , Time=0)
[230_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Pronto pra acabar com o Dalton?" , Time=0)
[231_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Sim. Vamos lá." , Time=0)
[232_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Merda. Ele está fugindo." , Time=0)
[233_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Não está, não. Vamos." , Time=0)
[234_MIA_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="DALTON: Vocês lembram da Somália? Nossa unidade inteira estava encurralada.  Os homens do Mo'Alim vinham pra acabar com a gente. Foi a única vez na vida em que perdi a esperança de verdade, em que senti medo de verdade. Mas vocês dois - acho que nunca perceberam quantas vidas salvaram naquele dia, o que fizeram pela nossa unidade, nem o orgulho que eu senti de vocês. E olho pra vocês agora, depois de tudo isso..." , Time=0)
[235_MIA_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: E sei que vocês amadureceram muito - nesses quinze anos. Mas - vocês ainda são meus garotos. Ainda são os melhores dos melhores - porque fui eu que treinei vocês pra serem os melhores. A gente passou por muita coisa - nós três. E eu - eu vou sentir falta de vocês." , Time=0)
[236_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: A gente derruba ele?" , Time=0)
[237_MIA_STOCKWELL SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="STOCKWELL: Vocês deixaram ele escapar. Foi um grande erro." , Time=0)
[238_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: A pesquisa diz:" , Time=0)
[239_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Você está morto." , Time=0)
[24_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="CHA_MIN_SOO: Ohhh... Odeio esse filho da puta." , Time=0)
[240_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Vamos - vamos dar o fora daqui." , Time=0)
[25_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152500"
Subtitles[0]=(Text="CHA MIN SOO: Vou dizer uma coisa. Mando um helicóptero buscar vocês no telhado do aeroporto. Usem o helicóptero pra achar aquele filho da puta do Clyde e matar ele pra mim. E - se virem algum guarda pessoal do Clyde, matem também!" , Time=0)
[26_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Mas o Clyde..." , Time=0)
[27_MIA_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="SALEM: ...vai sumir. A gente pega ele pra você." , Time=0)
[28_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="CHA_MIN_SOO: Ah, e... Se vocês também baterem meu helicóptero, eu mesmo arranco o saco de vocês fora. Tchau." , Time=0)
[28a_MIA_CHA_MIN_SOO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="08_sound_vo_main"
Subtitles[0]=(Text="CHA_MIN_SOO: Ah, e... Se vocês também baterem meu helicóptero, eu mato vocês com as minhas próprias mãos. Devagar... Tchau." , Time=0)
[29_MIA_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: O que você está fazendo, cara? O Clyde morreu na queda do avião." , Time=0)
[2A_MIA_S3kShUn8 SoundNodeWave]
bAlwaysLocalise=False
bManualWordWrap=True
Comment="cl# 150714"
