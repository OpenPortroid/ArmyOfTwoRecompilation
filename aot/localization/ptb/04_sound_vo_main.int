bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="DALTON: Rios, Salem - acabei de saber que o Departamento de Defesa quer informações sobre a fonte de financiamento desses caras. Então fiquem de olho num computador, arquivos, algo assim. Tem um belo bônus pra vocês se acharem alguma coisa. Câmbio." , Time=0)
