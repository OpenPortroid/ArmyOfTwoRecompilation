bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Dá pra CALAR A BOCA com essa merda de uma vez? Foque no que está fazendo e não perca tempo com essa besteira!" , Time=0)
