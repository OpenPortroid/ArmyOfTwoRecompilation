[156_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Que porra foi essa?" , Time=0)
[157_AFG_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: A gente tentou..." , Time=0)
[158_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="DALTON: Tentaram? Pois não tentaram o bastante" , Time=0)
Subtitles[1]=(Text="DALTON: e eu estou tirando vocês da missão!" , Time=3.13)
[159_AFG_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="RIOS: Entendido." , Time=0)
[169_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Verifiquem o GPS." , Time=0)
Subtitles[1]=(Text="DALTON: Vocês devem estar perto o bastante pra captar o sinal do Hicks. Câmbio." , Time=1.5)
[176_AFG_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Isso não tá certo. Mandar a gente aqui sem nem uma máscara de gás. Vou falar com o Dalton quando voltarmos." , Time=0)
[178_AFG_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Salem para Dalton. Essa área está cheia de algum tipo de gás. Câmbio." , Time=0)
[179_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: ...com a missão. Repito... sigam com a missão. Câmbio." , Time=0)
[180_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Sigam com a missão. Estão me ouvindo? Repito: sigam com a missão. Câmbio." , Time=0)
[183_AFG_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Não ouvi nada. Peço permissão pra abortar a missão. A sala está cheia de gás e não temos o equipamento certo. Câmbio." , Time=0)
[184_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Negativo... Sigam... Missão... Fiquem longe do... gás... limpos na base.... Câmbio e desligo." , Time=0)
[185_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Negativo. Sigam com a missão. Só fiquem longe do gás. A gente limpa vocês na base. Câmbio e desligo." , Time=0)
[188_AFG_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Então vamos logo. Não dá pra ficar muito tempo nesse gás." , Time=0)
[19_AFG_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Espero que a gente ache o Bin Laden aqui embaixo... São vinte milhões de dólares..." , Time=0)
[2_AFG_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Grande jogo, hein?" , Time=0)
[2_AFG_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Tenho certeza de que ela está bem. Você liga pra ela depois. Agora temos um trabalho a fazer." , Time=0)
[20_AFG_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Eles sabem onde ele está e não querem de jeito nenhum que a gente o encontre." , Time=0)
[202_AFG_TERRORIST SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="AL HABIIB: Você me diz para quem trabalha." , Time=0)
[203_AFG_HICKS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="HICKS: Vai se foder." , Time=0)
[206_AFG_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: É o Hicks." , Time=0)
[207_AFG_HICKS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="HICKS: AAAAHHHHhhhh!" , Time=0)
[209_AFG_TERRORIST SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="AL HABIIB: Isso é a foda que você leva, meu amigo. Quer mais uma foda?" , Time=0)
[21_AFG_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: É mesmo?" , Time=0)
[210_AFG_HICKS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="HICKS: Aaaah. Merda. MERDA! Aah. Eu não vou falar." , Time=0)
[211_AFG_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Estão espancando ele até quase matar. Temos que tirar ele de lá." , Time=0)
[212_AFG_HICKS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="HICKS: (GRITA DE DOR)" , Time=0)
[213_AFG_TERRORIST SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="AL HABIIB: Você fala - meu amigo... Sempre eles falam." , Time=0)
[215_AFG_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Ele não está aqui. É uma fita!" , Time=0)
[216_AFG_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="04_sound_vo_main"
Subtitles[0]=(Text="SALEM: Não brinca, Sherlock." , Time=0)
[217_AFG_HICKS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="HICKS: Aaah! Merda! Aaah!" , Time=0)
[22_AFG_BANTER_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Achem ele e a guerra acaba." , Time=0)
Subtitles[1]=(Text="RIOS: Sem mais justificativa pra roubar o petróleo do Iraque." , Time=1.5)
Subtitles[2]=(Text="RIOS: O Presidente não é burro, cara. Ele é do ramo do petróleo." , Time=4.2)
Subtitles[3]=(Text="RIOS: Tem que pensar nessa merda." , Time=7.7)
[222_AFG_TERRORIST SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="AL HABIIB: Você acha que é forte - como Hannibal do A-Team. Mas eu quebro você... Eu quebro você, meu amigo." , Time=0)
[223_AFG_HICKS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="HICKS: Aaaah! Meeerda! AAAH!" , Time=0)
[226_AFG_TERRORIST SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="AL HABIIB: Você pronto pra falar, meu amigo?" , Time=0)
[23_AFG_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Tem que relaxar com essas teorias da conspiração, cara." , Time=0)
[23_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Vocês dois destruíram aquele helicóptero? Câmbio." , Time=0)
[24_AFG_BANTER_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Rios, Salem. Tenho umas notícias pra vocês." , Time=0)
[24_AFG_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Destruímos, sim. Câmbio." , Time=0)
[25_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="DALTON: Muito bem. Acabei de saber que Nuri Yassan estava naquele helicóptero e o Departamento de Defesa o queria morto. Vocês vão ganhar um bônus. Vou processar o pagamento imediatamente. Câmbio e desligo." , Time=0)
[26_AFG_BANTER_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Isso vem direto do Stockwell.  Ainda não foi anunciado, então fica entre a gente.  Beleza?" , Time=0)
[263_AFG_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Hicks - é você?" , Time=0)
[264_AFG_Hicks SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152408"
Subtitles[0]=(Text="HICKS: Q-quem tá aí?" , Time=0)
[265_AFG_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Tyson Rios - SSC. Vou te tirar daqui." , Time=0)
[27_AFG_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Claro." , Time=0)
[270_AFG_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Ei, Hicks - é você?" , Time=0)
[271_AFG_Hicks SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152408"
Subtitles[0]=(Text="HICKS: Quem- quem tá aí?" , Time=0)
[272_AFG_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Tá tranquilo, cara. Eu sou da Companhia. Vou te tirar daqui." , Time=0)
[28_AFG_BANTER_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: A gente acabou de adquirir a Black Mountain Industries. A SSC agora é a maior empreiteira do mundo." , Time=0)
[28_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Vocês conseguiram destruir aquele helicóptero? Câmbio." , Time=0)
[280_AFG_HICKS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="HICKS: Eu achei... as ogivas... O Al Habiib trancou elas no laboratório... Segundo andar... Tem uma fechadura digital... chama o s3kShUn8." , Time=0)
[281_AFG_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Ouviu isso, Tyse? Seu melhor amigo." , Time=0)
[282_AFG_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Como você conhece o s3kShUn8?" , Time=0)
[283_AFG_Hicks SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152408"
Subtitles[0]=(Text="HICKS: Todo mundo... conhece ele." , Time=0)
[284_AFG_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="SALEM: Puta merda, cara. O que ele tem?" , Time=0)
[285_AFG_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Rios chamando Dalton.  Está me ouvindo?" , Time=0)
[289_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: ... te ouço..." , Time=0)
[29_AFG_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Black Mountain? Esses caras quase mataram a gente no México." , Time=0)
[29_AFG_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Não.  Erramos.  Câmbio." , Time=0)
[290_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Te ouço." , Time=0)
[292_AFG_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Achamos o Hicks. Ele está infectado com alguma coisa." , Time=0)
[3_AFG_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Apostei dez mil na diferença." , Time=0)
[3_AFG_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Falando em \"trabalho a fazer\", é melhor você derrubar aquele helicóptero..." , Time=0)
[30_AFG_BANTER_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Eles só estavam fazendo o trabalho deles. Enfim, não conta pro Stockwell que eu falei isso." , Time=0)
[30_AFG_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Que pena. O Nuri Yassan estava a bordo, e querem ele morto. Teria sido um belo bônus pra vocês. Da próxima vez, não errem. Câmbio e desligo." , Time=0)
[302_AFG_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Desculpa, cara." , Time=0)
[31_AFG_BANTER_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Pois é, como se a gente falasse com ele todo dia..." , Time=0)
[32_AFG_BANTER_DALTON SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Beleza, rapazes. Câmbio e desligo." , Time=0)
[343_AFG_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Quer resolver um mistério? Beleza, tenho um jogo de DETETIVE pra você jogar quando a gente voltar pra casa. Até lá, foca em sair daqui sem morrer nem pegar alguma doença esquisita." , Time=0)
