bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="DALTON: Bom trabalho. Ainda deve ter ogivas em algum lugar da instalação. Quero essas destruídas também." , Time=0)
[147_AFG_DALTON SoundNodeWave]
