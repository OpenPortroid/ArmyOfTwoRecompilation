[SE_L10_015_MURRAY_005 SoundNodeWave]
Subtitles[0]=(Text="MURRAY: Vão pro andar seguinte." , Time=0)
Subtitles[1]=(Text="Tem uma parede precisando de cirurgia desconstrutiva." , Time=1)

[SE_L10_016_RIOS_005 SoundNodeWave]
