[SE_L10_033_MURRAY_013 SoundNodeWave]
Subtitles[0]=(Text="MURRAY: Não tem como errar." , Time=0)
Subtitles[1]=(Text="Fica bem do lado do Quartel de Inteligência.  Câmbio, desligo." , Time=1)

[SE_L10_034_SALEM_011 SoundNodeWave]
Subtitles[0]=(Text="SALEM: Esse é o nosso passe pro Quartel Tático." , Time=0)

[SE_L10_035_DALTON_001 SoundNodeWave]
Subtitles[0]=(Text="DALTON: Que me enforquem.  A dupla improvável ataca de novo..." , Time=0)

[SE_L10_036_DALTON_002 SoundNodeWave]
