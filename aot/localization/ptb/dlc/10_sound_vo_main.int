[SE_L10_020_SALEM_007 SoundNodeWave]
Subtitles[0]=(Text="SALEM: Deve ser isso aqui." , Time=0)

[SE_L10_021_SALEM_008 SoundNodeWave]
Subtitles[0]=(Text="SALEM: Alice, estamos indo pro elevador." , Time=0)

[SE_L10_022_RIOS_007 SoundNodeWave]
Subtitles[0]=(Text="RIOS: Beco sem saída.  Essa é a sua ideia de entrada rápida?" , Time=0)

[SE_L10_023_MURRAY_008 SoundNodeWave]
Subtitles[0]=(Text="MURRAY: Uns veem um beco sem saída, outros veem uma chance de pirotecnia." , Time=0)

[SE_L10_025_MURRAY_010 SoundNodeWave]
Subtitles[0]=(Text="MURRAY: O Quartel de Inteligência e Tática" , Time=0)
Subtitles[1]=(Text="fica logo do outro lado dessa parede." , Time=2)

[SE_L10_026_SALEM_009 SoundNodeWave]
Subtitles[0]=(Text="SALEM: Odeio dizer isso, mas esse filho da puta de concreto tem que ir pro chão." , Time=0)

[SE_L10_028_RIOS_008 SoundNodeWave]
Subtitles[0]=(Text="RIOS: Lá vai!  Cubram-se!" , Time=0)

[SE_L10_029_RIOS_009 SoundNodeWave]
Subtitles[0]=(Text="RIOS: Alice, estamos do outro lado." , Time=0)

[SE_L10_031_MURRAY_012 SoundNodeWave]
Subtitles[0]=(Text="MURRAY: Tenho certeza de que essa detonação não passou despercebida." , Time=0)
