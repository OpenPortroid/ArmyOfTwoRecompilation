[5_CHI_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="07_sound_vo_main"
Subtitles[0]=(Text="SALEM: Sério, mano, tenho certeza de que não foi o Clyde. Foi aquele babaca do \"Cebu Mohammed\", ou sei lá o quê. Mas daqui a uns dez minutos a gente mata ele, e o mundo vai ficar seguro - ninguém mais vai precisar se preocupar com terroristas pegando armas nucleares." , Time=0)
