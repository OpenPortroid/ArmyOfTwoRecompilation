[55_CHI_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="07_sound_vo_main"
Subtitles[0]=(Text="MURRAY: Aliás, acabei de ver que tem recompensa por cada helicóptero militar e cada soldado chinês bem armado que vocês derrubarem. Boa sorte." , Time=0)
