bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Meu Deus. A AP está noticiando que o senador Richard Whitehorse foi morto por terroristas coreanos ao atravessar uma ponte sobre o rio Lijiang." , Time=0)
