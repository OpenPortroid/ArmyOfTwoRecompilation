bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Que bom." , Time=0)
Subtitles[1]=(Text="RIOS: Do jeito que as coisas vão hoje, a gente pode ter que usar!" , Time=0.5)
[3_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Vocês dois deveriam pousar perto da traseira do porta-aviões. Parece que tem menos atividade lá. Câmbio e desligo." , Time=0)
[30_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="06_sound_vo_main"
Subtitles[0]=(Text="RIOS: É a Marinha das Filipinas ou os terroristas?" , Time=0)
[31_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="06_sound_vo_main"
Subtitles[0]=(Text="SALEM: Quem porra se importa, cara? Estão atirando na gente - atira de volta!" , Time=0)
