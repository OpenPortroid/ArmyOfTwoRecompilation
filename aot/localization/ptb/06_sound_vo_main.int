bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Claro. Nós vamos fazer isso." , Time=0)
[87_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Ótimo. Agora desçam de elevador até o Hangar \"B.\" Atravessem esse hangar até o Hangar \"C.\" Eu dou mais instruções pelo rádio e, é, boa sorte." , Time=0)
