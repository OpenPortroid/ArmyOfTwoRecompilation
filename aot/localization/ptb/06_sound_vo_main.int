bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Rios, Salem! Saiam já desse navio!" , Time=0)
[137B_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Saiam desse navio, pessoal!" , Time=0)
[138_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Não sei se dá para voltar para a SSC agora. A gente não sabe se o Clyde age sozinho... E se não age, eles sabem que a gente sabe." , Time=0)
[139_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Dá para parar com essa merda de uma vez? Tenho certeza que o Clyde só tava tentando ganhar uma grana extra. Não é nenhuma grande conspiração." , Time=0)
[14_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="06_sound_vo_main"
Subtitles[0]=(Text="MURRAY: Vocês estão me fazendo perder tempo de propósito? Desativem aqueles aviões. Câmbio." , Time=0)
[140_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Não sei, cara... Simplesmente não sei..." , Time=0)
[15_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Bom trabalho, pessoal. Agora só falta chegar à ponte. Câmbio e desligo." , Time=0)
[16_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Rios para Clyde. Estamos indo para a torre de controle. Informe sua posição. Câmbio." , Time=0)
[17_ACC_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="CLYDE: Eu informo que é melhor vocês ficarem bem longe de mim -" , Time=0)
Subtitles[1]=(Text="CLYDE: se sabem o que é bom para vocês." , Time=2.59)
[18_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Ei, Alice - qual é a do Clyde? Ele desceu para o convés inferior por algum motivo." , Time=0)
[19_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: O Clyde responde direto ao Dalton. O que quer que ele esteja fazendo não é da conta de vocês - nem da minha. Se precisarem de algo dele, me avisem e eu falo com o Dalton. Fora isso, vocês conhecem suas ordens. Câmbio e desligo." , Time=0)
[2_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Por quê? É isso que a gente faz para ganhar a vida." , Time=0)
[20_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Merda. Não tem como entrar aqui. Vamos ter que achar outro caminho até a sala de controle." , Time=0)
[21_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Talvez tenha uma entrada pelo convés inferior." , Time=0)
[22_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: É, eu não entendo nada de projeto de porta-aviões," , Time=0)
Subtitles[1]=(Text="RIOS: mas acho que você deve estar certo!" , Time=2.7)
[23_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Merda. Parece que não vamos entrar por aqui." , Time=0)
[24_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Vamos ter que entrar pelo convés inferior." , Time=0)
[25_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151405"
Subtitles[0]=(Text="MURRAY: Pessoal, o Departamento de Defesa não quer outra PMC levando o crédito" , Time=0)
Subtitles[1]=(Text="MURRAY: por limpar mais uma das merdas deles, então" , Time=3.24)
Subtitles[2]=(Text="MURRAY: eles acabaram de mandar um esquadrão de SEALs da Marinha para o porta-aviões." , Time=6.14)
[26_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Então o que você tá dizendo é que a gente faz todo o trabalho e deixa eles ficarem com o crédito?" , Time=0)
[27_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Se sabem o que é bom para vocês, sim. Câmbio." , Time=0)
[28_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151405"
Subtitles[0]=(Text="SALEM: Parece que os marinheiros deixaram um bote salva-vidas quando evacuaram o porta-aviões." , Time=0)
