[10_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Esperem - não podemos deixar mais nenhum desses terroristas decolar. Há quatro jatos nas pistas do porta-aviões perto das portas blindadas. Desativem o sistema de ignição dos jatos e vocês desativam as pistas." , Time=0)
[100_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: O Eisenhower morreu no Iraque. Você viu ele morrer." , Time=0)
[101_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: O Clyde vazou aquelas posições das tropas. Ele é o responsável pelo que aconteceu com o Eisenhower." , Time=0)
[102_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Pedro, cara, o Eisenhower... Eram os únicos que restavam do nosso esquadrão de Rangers. Não acredito nisso!" , Time=0)
[103_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Harris para os contratados caubóis. E aí, onde diabos vocês estão? Isto aqui não é exatamente um cruzeiro de lazer. Câmbio." , Time=0)
[104_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Acabamos de entrar no Hangar \"B\". Câmbio." , Time=0)
[105_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Então andem logo, porra. Cadê os SEALs da Marinha?" , Time=0)
[106_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Eles estão... Estão mortos, senhor." , Time=0)
[107_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Ah, merda. Que maravilha, hein? Isso quer dizer que vocês são nossa única esperança. Se vocês dois forem baleados ou fizerem merda, muita gente vai morrer. Câmbio." , Time=0)
[108_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Vamos tentar não fazer isso, senhor. Câmbio." , Time=0)
[109_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Caubóis! Já estão no Hangar \"C\"? Câmbio." , Time=0)
[11_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Entendido! Estamos a caminho." , Time=0)
[110_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: A porta entre os hangares está fechada - não tem como passar!" , Time=0)
[111_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Então deem um jeito de passar, caralho! Droga! Eles não ensinam nada no setor privado?" , Time=0)
[111A_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Essas portas são hidráulicas. Se a gente destruir a válvula, libera a pressão e consegue abrir as portas." , Time=0)
[111B_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Peraí, merda, aquilo parece o painel lá em cima. Não acredito que você tinha razão." , Time=0)
[111C_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: O que é aquela coisa lá em cima, acima da grade?" , Time=0)
[111D_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Puta merda! Essas portas são hidráulicas. Se a gente destruir aquela válvula, dá para empurrar as portas. Bom trabalho, Salem!" , Time=0)
[112_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Já acharam um jeito de passar por aquela porta, rapazes?" , Time=0)
[113_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Estamos trabalhando nisso. Câmbio." , Time=0)
[114_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Vamos lá, usem a criatividade. Câmbio." , Time=0)
[115_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Vocês dois é melhor se apressarem e descobrirem como passar por aquela porta - e rápido! Câmbio!" , Time=0)
[116_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Contratados da SSC para o Capitão Harris. Estamos dentro do Hangar \"C\". Peço instruções." , Time=0)
[117_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 152440"
Subtitles[0]=(Text="CPT HARRIS: Certo, vocês precisam carregar o máximo de munição pesada que puderem na plataforma do elevador no chão. Não percam tempo com coisa pequena. Cento e cinquenta e oito, Mark 84, GBU 28. Quando estiver tudo empilhado, me avisem e eu baixo o elevador e a gente detona." , Time=0)
[118_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Certo. Chamamos quando os explosivos estiverem na plataforma. Câmbio e desligo." , Time=0)
[119_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Entendeu?" , Time=0)
[12_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Pessoal - aonde vocês estão indo? Vocês precisam destruir o sistema de ignição daqueles jatos." , Time=0)
[120_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Vamos nessa, mano!" , Time=0)
[121_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Estão prontos?" , Time=0)
[122_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Ainda não. Trabalhando o mais rápido que dá. Câmbio." , Time=0)
[123_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Então andem logo. Aqui em cima tá ficando mais cabeludo que cu de macaco - e já estamos quase em Manila." , Time=0)
[124_ACC_SALEM SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="SALEM: Indo o mais rápido que dá, Capitão. Câmbio e desligo." , Time=0)
[125_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Rios para Harris. Está me ouvindo?" , Time=0)
[126_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Te ouço. Está tudo pronto?" , Time=0)
[127_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: Sim. Baixe a plataforma. Assim que voltarmos para a ponte, pode detonar." , Time=0)
[128_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Mentalidade típica do setor privado -" , Time=0)
Subtitles[1]=(Text="CPT HARRIS: sempre pensando em si mesmos primeiro...." , Time=2.2)
Subtitles[2]=(Text="CPT HARRIS: Se estivessem sob meu comando, eu colocava vocês na linha." , Time=4.38)
Subtitles[3]=(Text="CPT HARRIS: Há milhões de vidas em jogo." , Time=7.1)
Subtitles[4]=(Text="CPT HARRIS: Não temos tempo a perder." , Time=8.8)
Subtitles[5]=(Text="CPT HARRIS: Vou detonar essas cargas assim que o elevador descer," , Time=10.5)
Subtitles[6]=(Text="CPT HARRIS: então sugiro que comecem a se mexer." , Time=14.1)
[129_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Bravo Zulu, rapazes. Vocês conseguiram. Tem um bote salva-vidas na popa. Podem usar para dar o fora daqui." , Time=0)
[13_ACC_MURRAY SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Aonde diabos vocês estão indo? Desativem aqueles aviões! Câmbio." , Time=0)
[130_ACC_RIOS SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="RIOS: A gente? E você? Vem com a gente." , Time=0)
[131_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Impossível, soldado. O Capitão sempre afunda com o navio. Honra e dever." , Time=0)
[131A_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="06_sound_vo_main"
Subtitles[0]=(Text="CAPTAIN: Stand Navy out to sea. Fight our battle cry: We'll never change our course. So vicious foes steer shy-y-y-y. Roll out the T. N. T. Anchors Aweigh. Sail on to victory. And sink their bones to Davy Jones, hooray!" , Time=0)
