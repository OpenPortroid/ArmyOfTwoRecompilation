[83_ACC_CAPTAIN SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 151790"
Subtitles[0]=(Text="CPT HARRIS: Sou capitão da Marinha. Sacanear não está na minha descrição de cargo. Agora escutem. Os Seals da Marinha estão a caminho, mas não podemos esperar. Preciso que me ajudem a afundar este navio antes que chegue a Manila." , Time=0)
