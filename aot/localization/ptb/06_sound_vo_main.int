bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150714"
Subtitles[0]=(Text="MURRAY: Que porra está acontecendo? Por que deixaram o Capitão na ponte? Ele estava ferido! Câmbio." , Time=0)
