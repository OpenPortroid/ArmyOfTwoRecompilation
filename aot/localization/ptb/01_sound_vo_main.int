bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="PEDRO: Certo. O principal aqui é treinar o fogo de supressão. Basicamente, fiquem atrás da cobertura e atirem às cegas. Câmbio." , Time=0)
