bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="RIOS: O quê? Por quê?" , Time=0)
[152_SOM_CLYDE SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
