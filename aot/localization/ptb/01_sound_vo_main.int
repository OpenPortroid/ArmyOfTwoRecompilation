bAlwaysLocalise=True
bManualWordWrap=False
Comment="cl# 150340"
Subtitles[0]=(Text="RIOS: Sou o Cabo Tyson Rios, e este é o Soldado de Primeira Classe Elliot Salem, Chalk Four, Rangers do Exército dos EUA. Você é o Phillip Clyde?" , Time=0)
