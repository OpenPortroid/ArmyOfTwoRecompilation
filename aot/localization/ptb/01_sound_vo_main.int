bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="PEDRO: Isso é o que você pensa, ese. Depois daquela palhaçada que você aprontou no refeitório ontem à noite, mandei meus caras não pegarem leve! Vocês dois vão levar uma surra. Câmbio." , Time=0)
