[65_TRAINING_PEDRO SoundNodeWave]
bAlwaysLocalise=True
bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="PEDRO: Estamos na metade, então podem encarar isto como a prova do meio do curso. Quero que usem as habilidades que acabamos de ver para eliminar esse cara.  Ele tem colete e as melhores armas, então não vai ser fácil. Câmbio." , Time=0)
