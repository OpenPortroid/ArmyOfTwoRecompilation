bManualWordWrap=True
Comment="01_sound_vo_main"
Subtitles[0]=(Text="PEDRO: Cada um de vocês precisa chamar a atenção do metralhador. Um de cada vez. Revezem.  Quero que comecem a pensar estrategicamente. Quando um estiver sob fogo, o outro tem que dar fogo de supressão pra atrair a atenção do inimigo." , Time=0)
